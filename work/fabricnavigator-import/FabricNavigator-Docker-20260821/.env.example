# GitHub repository used for release checks, without https://github.com/.
FABRICNAVIGATOR_GITHUB_REPOSITORY=marlon82/FabricNavigator

# Relative host path only. The file itself is excluded from Git and mounted
# read-only into the container by Compose.
FABRICNAVIGATOR_GITHUB_TOKEN_FILE=secrets/github-update-token.txt

# Optional custom loopback health endpoint used by the Windows updater.
FABRICNAVIGATOR_HEALTH_URL=https://localhost:8443/health.jsp
