<%@ page import="java.util.*,com.fabricnavigator.features.FeatureFlags,com.fabricnavigator.firmware.FirmwareLifecycleSettings,com.fabricnavigator.firmware.FirmwareLifecycleSettings.Policy,com.fabricnavigator.firmware.FirmwarePackageStore,com.fabricnavigator.security.CredentialVault,com.fabricnavigator.security.EdmSecurity,com.fabricnavigator.security.AuditLog" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%!
private static String h(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private static String j(String s){if(s==null)return "";return s.replace("\\","\\\\").replace("\"","\\\"").replace("\r"," ").replace("\n"," ").replace("<","\\u003c");}
%><%
response.setHeader("Cache-Control","no-store");if(!EdmSecurity.isAdmin(request)){response.sendError(403);return;}if(!FeatureFlags.firmwareLifecycleEnabled()){response.sendError(404);return;}
String csrf=EdmSecurity.csrf(session),actor=EdmSecurity.currentUser(request),flash="",error="";
if("POST".equalsIgnoreCase(request.getMethod())){if(!EdmSecurity.validCsrf(request)){response.sendError(403);return;}String action=request.getParameter("action");try{if("savePolicy".equals(action)){FirmwareLifecycleSettings.save(request.getParameter("model"),request.getParameter("targetVersion"),request.getParameter("minimumSourceVersion"),request.getParameter("role"),request.getParameter("notes"));AuditLog.log(actor,"FIRMWARE_POLICY_SAVED","model="+request.getParameter("model")+" · target="+request.getParameter("targetVersion")+" · minimum="+request.getParameter("minimumSourceVersion")+" · role="+request.getParameter("role"),com.fabricnavigator.web.ClientAddress.of(request));flash="saved";}else if("deletePolicy".equals(action)){FirmwareLifecycleSettings.delete(request.getParameter("model"));AuditLog.log(actor,"FIRMWARE_POLICY_DELETED","model="+request.getParameter("model"),com.fabricnavigator.web.ClientAddress.of(request));flash="deleted";}}catch(Exception ex){application.log("Firmware lifecycle policy operation failed",ex);error=ex.getMessage()==null?"operationFailed":ex.getMessage();}}
List<String> devices=new ArrayList<String>(CredentialVault.listAssignedDevices());Collections.sort(devices);List<Policy> policies=FirmwareLifecycleSettings.list();List<FirmwarePackageStore.Package> packages=FirmwarePackageStore.list();
%><!doctype html><html lang="de" class="fn-shell-loading" data-app="fabricnavigator-firmware" data-fn-user="<%=h(actor)%>" data-fn-role="admin"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Firmware &amp; Lifecycle · FabricNavigator</title><script>(function(){try{var l=localStorage.getItem('edmLanguage'),t=localStorage.getItem('edmTheme');if(l)document.documentElement.lang=l;if(!t&&matchMedia)t=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';document.documentElement.dataset.theme=t||'light';}catch(e){document.documentElement.dataset.theme='light';}})();</script><link rel="stylesheet" href="/assets/security.css"><link rel="stylesheet" href="/assets/app-shell.css?v=20260907-301"><link rel="stylesheet" href="/assets/firmware-lifecycle.css?v=20260907-302"></head><body>
<header class="header"><div class="header-inner"><span class="brand-logo"><img class="logo logo-light" src="/assets/FabricNavigator_modern_schwarz.png" alt="FabricNavigator"><img class="logo logo-dark" src="/assets/FabricNavigator_modern.png" alt="FabricNavigator"></span><nav class="nav"><form method="post" action="/logout.jsp"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><button type="submit">Sign out</button></form></nav></div></header>
<main class="fn-firmware-page"><div class="fn-page-heading"><div><span data-de="FIRMWARE &amp; LIFECYCLE" data-en="FIRMWARE &amp; LIFECYCLE">FIRMWARE &amp; LIFECYCLE</span><h1 data-de="Firmware- und Lifecycle-Management" data-en="Firmware and lifecycle management">Firmware- und Lifecycle-Management</h1><p data-de="Firmwarestände zentral inventarisieren, Abweichungen erkennen und Upgrade-Pfade sicher planen." data-en="Centrally inventory firmware, detect deviations, and safely plan upgrade paths."></p></div><button type="button" id="refresh-inventory" data-de="Inventar aktualisieren" data-en="Refresh inventory">Inventar aktualisieren</button></div>
<%if(flash.length()>0){%><div class="alert success" data-de="<%="deleted".equals(flash)?"Firmware-Richtlinie gelöscht.":"Firmware-Richtlinie gespeichert."%>" data-en="<%="deleted".equals(flash)?"Firmware policy deleted.":"Firmware policy saved."%>"></div><%}if(error.length()>0){%><div class="alert error"><%=h(error)%></div><%}%>
<section class="fn-firmware-summary" aria-label="Summary"><article><span data-de="Geräte" data-en="Devices">Geräte</span><strong id="summary-devices">0</strong></article><article><span data-de="Modelle" data-en="Models">Modelle</span><strong id="summary-models">0</strong></article><article><span data-de="Abweichungen" data-en="Deviations">Abweichungen</span><strong id="summary-deviations">0</strong></article><article><span data-de="Prüfung offen" data-en="Review required">Prüfung offen</span><strong id="summary-review">0</strong></article></section>
<section class="fn-firmware-card"><div class="fn-section-title"><div><h2 data-de="Installierte Firmware" data-en="Installed firmware">Installierte Firmware</h2><p data-de="Die Daten werden im Hintergrund über die bereits zugewiesenen SNMP-Profile geladen. Markiere Geräte hier für einen Rollout." data-en="Data is loaded in the background through the already assigned SNMP profiles. Select devices here for deployment."></p></div><span class="fn-loading-state" id="inventory-state"></span></div><label class="fn-firmware-search"><span aria-hidden="true">⌕</span><input type="search" id="firmware-search" data-de-placeholder="Nach Name, IP, Modell oder Version suchen" data-en-placeholder="Search by name, IP, model, or version"></label><div class="fn-table-scroll"><table id="firmware-inventory"><thead><tr><th><input type="checkbox" id="select-all-firmware" aria-label="Select all visible devices"></th><th data-sort="name" data-de="Gerät" data-en="Device">Gerät</th><th data-sort="ip" data-de="IP-Adresse" data-en="IP address">IP-Adresse</th><th data-sort="model" data-de="Modell" data-en="Model">Modell</th><th data-sort="version" data-de="Installiert" data-en="Installed">Installiert</th><th data-sort="target" data-de="Zielversion" data-en="Target">Zielversion</th><th data-sort="state" data-de="Lifecycle-Status" data-en="Lifecycle status">Lifecycle-Status</th></tr></thead><tbody><%for(String ip:devices){%><tr data-ip="<%=h(ip)%>"><td><input type="checkbox" class="fn-firmware-device" value="<%=h(ip)%>"></td><td data-field="name"><span class="fn-skeleton"></span></td><td><code><%=h(ip)%></code></td><td data-field="model"><span class="fn-skeleton"></span></td><td data-field="version"><span class="fn-skeleton short"></span></td><td data-field="target">—</td><td data-field="state"><span class="fn-status pending" data-de="Wird geprüft" data-en="Checking">Wird geprüft</span></td></tr><%}%></tbody></table></div></section>
<div class="fn-firmware-grid"><section class="fn-firmware-card"><h2 data-de="Nach Modell und Firmware gruppiert" data-en="Grouped by model and firmware">Nach Modell und Firmware gruppiert</h2><p class="fn-description" data-de="Identische Modell-/Firmwarestände werden zusammengefasst. Abweichungen innerhalb eines Modells sind hervorgehoben." data-en="Identical model and firmware levels are grouped. Deviations within a model are highlighted."></p><div id="firmware-groups" class="fn-firmware-groups"><p class="fn-empty" data-de="Inventar wird geladen …" data-en="Loading inventory …"></p></div></section>
<section class="fn-firmware-card"><h2 data-de="Upgrade-Reihenfolge" data-en="Upgrade sequence">Upgrade-Reihenfolge</h2><p class="fn-description" data-de="Der Plan ordnet notwendige Upgrades nach Access, Distribution und Core. Er installiert keine Firmware und berücksichtigt nur hinterlegte Richtlinien." data-en="The plan orders required upgrades by access, distribution, and core. It does not install firmware and only uses configured policies."></p><ol id="upgrade-plan" class="fn-upgrade-plan"><li class="fn-empty" data-de="Noch kein Upgrade erforderlich oder keine Zielversion hinterlegt." data-en="No upgrade required yet or no target version configured."></li></ol></section></div>
<section class="fn-firmware-card"><h2 data-de="Firmware bereitstellen und ausrollen" data-en="Stage and deploy firmware">Firmware bereitstellen und ausrollen</h2><p class="fn-description" data-de="Firmwaredateien werden geschützt gespeichert und mit SHA-256 verifiziert. Vor dem Start siehst du die vollständige gerätespezifische Befehlsvorschau. Standardmäßig wird die Software nur übertragen, installiert und für den nächsten Neustart aktiviert; ein sofortiger Neustart ist separat auszuwählen." data-en="Firmware files are stored securely and verified with SHA-256. The complete device-specific command preview is shown before starting. By default, software is only transferred, installed, and activated for the next reboot; an immediate reboot must be selected separately."></p>
<form id="firmware-upload-form" class="fn-policy-form" enctype="multipart/form-data"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="upload"><label class="wide"><span data-de="Firmwaredatei" data-en="Firmware file">Firmwaredatei</span><input type="file" name="firmwareFile" required accept=".voss,.xos,.xmod"><small data-de="Modell, kompatible Geräte, Version, Plattform und Aktivierungsname werden sicher aus den eingebetteten Firmware-Metadaten gelesen." data-en="Model, compatible devices, version, platform, and activation name are read safely from the embedded firmware metadata.">Modell, kompatible Geräte, Version, Plattform und Aktivierungsname werden sicher aus den eingebetteten Firmware-Metadaten gelesen.</small></label><button type="submit" data-de="Analysieren und hochladen" data-en="Analyze and upload">Analysieren und hochladen</button></form><div id="firmware-upload-status" class="fn-inline-status"></div>
<div class="fn-table-scroll"><table class="fn-package-table"><thead><tr><th data-de="Datei" data-en="File">Datei</th><th data-de="Erkannte Familie" data-en="Detected family">Erkannte Familie</th><th data-de="Kompatible Geräte" data-en="Compatible devices">Kompatible Geräte</th><th data-de="Version" data-en="Version">Version</th><th data-de="Plattform" data-en="Platform">Plattform</th><th>SHA-256</th><th></th></tr></thead><tbody><%for(FirmwarePackageStore.Package p:packages){%><tr data-package-id="<%=h(p.id)%>" data-file="<%=h(p.fileName)%>" data-model="<%=h(p.model)%>" data-compatible-models="<%=h(p.compatibleModels)%>" data-version="<%=h(p.version)%>" data-platform="<%=h(p.platform)%>" data-activation="<%=h(p.activation)%>"><td><strong><%=h(p.fileName)%></strong><small><%=String.format(Locale.ENGLISH,"%.1f MiB",p.size/1048576.0)%></small></td><td><%=h(p.model)%><%if(p.architecture.length()>0){%><small><%=h(p.architecture)%></small><%}%></td><td><small><%=h(p.compatibleModels.replace(",",", "))%></small></td><td><%=h(p.version)%></td><td><%=h(p.platform)%></td><td><code title="<%=h(p.sha256)%>"><%=h(p.sha256.substring(0,Math.min(12,p.sha256.length())))%>…</code></td><td><div class="fn-package-actions"><button type="button" class="fn-deploy-open" data-de="Ausrollen" data-en="Deploy">Ausrollen</button><button type="button" class="danger fn-package-delete" data-de="Löschen" data-en="Delete">Löschen</button></div></td></tr><%}if(packages.isEmpty()){%><tr><td colspan="7" class="fn-empty" data-de="Noch keine Firmwaredatei hochgeladen." data-en="No firmware file uploaded yet.">Noch keine Firmwaredatei hochgeladen.</td></tr><%}%></tbody></table></div></section>
<section class="fn-firmware-card"><h2 data-de="Kompatibilitätsrichtlinien" data-en="Compatibility policies">Kompatibilitätsrichtlinien</h2><p class="fn-description" data-de="Definiere pro Modell die freigegebene Zielversion und optional die niedrigste direkt upgradefähige Ausgangsversion. Ohne Richtlinie wird nur eine Abweichung vom häufigsten Firmwarestand des Modells erkannt; eine Herstellerkompatibilität wird dann nicht behauptet." data-en="Define the approved target and optionally the lowest directly upgradable source version for each model. Without a policy, only deviation from the model's most common firmware is detected; vendor compatibility is not asserted."></p>
<div class="fn-table-scroll"><table class="fn-policy-table"><thead><tr><th data-de="Modell" data-en="Model">Modell</th><th data-de="Ziel" data-en="Target">Ziel</th><th data-de="Min. Ausgangsversion" data-en="Minimum source">Min. Ausgangsversion</th><th data-de="Rolle" data-en="Role">Rolle</th><th data-de="Hinweis" data-en="Note">Hinweis</th><th></th></tr></thead><tbody><%for(Policy p:policies){%><tr><td><strong><%=h(p.model)%></strong></td><td><%=h(p.targetVersion)%></td><td><%=p.minimumSourceVersion.length()>0?h(p.minimumSourceVersion):"—"%></td><td><%=h(p.role)%></td><td><%=p.notes.length()>0?h(p.notes):"—"%></td><td><form method="post"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="deletePolicy"><input type="hidden" name="model" value="<%=h(p.model)%>"><button class="danger" type="submit" data-de="Löschen" data-en="Delete">Löschen</button></form></td></tr><%}%></tbody></table></div>
<form method="post" class="fn-policy-form"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="savePolicy"><label><span data-de="Modell" data-en="Model">Modell</span><input name="model" list="detected-models" required maxlength="160"><datalist id="detected-models"></datalist></label><label><span data-de="Freigegebene Zielversion" data-en="Approved target version">Freigegebene Zielversion</span><input name="targetVersion" required maxlength="80"></label><label><span data-de="Niedrigste direkte Ausgangsversion (optional)" data-en="Lowest direct source version (optional)">Niedrigste direkte Ausgangsversion (optional)</span><input name="minimumSourceVersion" maxlength="80"></label><label><span data-de="Netzwerkrolle" data-en="Network role">Netzwerkrolle</span><select name="role"><option value="access">Access</option><option value="distribution">Distribution</option><option value="core">Core</option><option value="other" data-de="Sonstige" data-en="Other">Sonstige</option></select></label><label class="wide"><span data-de="Planungshinweis (optional)" data-en="Planning note (optional)">Planungshinweis (optional)</span><input name="notes" maxlength="600"></label><button type="submit" data-de="Richtlinie speichern" data-en="Save policy">Richtlinie speichern</button></form></section>
</main><div class="fn-firmware-dialog" id="firmware-deploy-dialog" hidden><section role="dialog" aria-modal="true"><header><div><strong data-de="Firmware-Rollout prüfen" data-en="Review firmware deployment">Firmware-Rollout prüfen</strong><small id="deploy-subtitle"></small></div><button type="button" id="deploy-close" aria-label="Close">×</button></header><div class="fn-dialog-body"><div class="fn-warning" data-de="Achtung: Ein Firmwarewechsel kann den Netzwerkbetrieb unterbrechen. Prüfe die Release Notes des Herstellers, den Upgrade-Pfad, Modellkompatibilität, Stack-/Cluster-Abhängigkeiten und verfügbare Boot-Images. FabricNavigator kann diese Herstelleranforderungen nicht vollständig automatisch validieren." data-en="Caution: Firmware changes can interrupt network operation. Review vendor release notes, the upgrade path, model compatibility, stack/cluster dependencies, and available boot images. FabricNavigator cannot fully validate these vendor requirements automatically."></div><h3 data-de="Ausgewählte Geräte" data-en="Selected devices">Ausgewählte Geräte</h3><div id="deploy-devices"></div><h3 data-de="Befehlsvorschau" data-en="Command preview">Befehlsvorschau</h3><pre id="deploy-preview"></pre><label class="fn-reboot-choice"><input type="checkbox" id="deploy-reboot"><span data-de="Geräte nach erfolgreicher Aktivierung sofort neu starten" data-en="Immediately reboot devices after successful activation">Geräte nach erfolgreicher Aktivierung sofort neu starten</span></label><label class="fn-confirm-choice"><input type="checkbox" id="deploy-confirm"><span data-de="Ich habe Kompatibilität und Upgrade-Pfad geprüft und bestätige den Rollout." data-en="I reviewed compatibility and the upgrade path and confirm deployment.">Ich habe Kompatibilität und Upgrade-Pfad geprüft und bestätige den Rollout.</span></label></div><footer><button type="button" class="secondary" id="deploy-cancel" data-de="Abbrechen" data-en="Cancel">Abbrechen</button><button type="button" id="deploy-start" disabled data-de="Rollout starten" data-en="Start deployment">Rollout starten</button></footer></section></div><aside class="fn-deployment-progress" id="deployment-progress" hidden><header><div><strong data-de="Firmware-Rollout" data-en="Firmware deployment">Firmware-Rollout</strong><small id="deployment-message"></small></div><button type="button" id="deployment-close">×</button></header><div class="fn-deployment-track"><span></span></div><div id="deployment-results"></div></aside><script>window.FN_FIRMWARE_CSRF='<%=j(csrf)%>';window.FN_FIRMWARE_POLICIES=[<%for(int i=0;i<policies.size();i++){Policy p=policies.get(i);if(i>0)out.print(',');%>{"model":"<%=j(p.model)%>","target":"<%=j(p.targetVersion)%>","minimum":"<%=j(p.minimumSourceVersion)%>","role":"<%=j(p.role)%>","notes":"<%=j(p.notes)%>"}<%}%>];</script><script src="/assets/app-shell.js?v=20260907-302"></script><script src="/assets/firmware-lifecycle.js?v=20260907-302"></script></body></html>
