private static final Path SECURITY=Paths.get(System.getProperty("fabricnavigator.data.dir","/opt/fabricnavigator/data"));
private static final Path WEB_PROFILE_IDS=SECURITY.resolve("webview-profile-ids.properties"),DEFAULT_CREDENTIALS_MARKER=SECURITY.resolve("default-credentials.initialized"),DEFAULT_ASSIGNMENTS=SECURITY.resolve("default-credential-assignments.properties"),EXCLUDES=SECURITY.resolve("discovery-excludes.txt");
private static File hostFile(String name){String root=System.getenv("FABRICNAVIGATOR_UPDATE_DIR");if(root==null||root.trim().length()==0)root="/opt/fabricnavigator/update";return new File(root,name);}
private static String h(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private static String p(String[] values,int index){return values!=null&&index<values.length&&values[index]!=null?values[index].trim():"";}
private static boolean ipv4(String value){if(value==null)return false;String[] parts=value.split("\\.",-1);if(parts.length!=4)return false;for(String part:parts)try{if(!part.matches("\\d{1,3}")||Integer.parseInt(part)>255)return false;}catch(Exception ex){return false;}return true;}
private static boolean privateIpv4(String value){if(!ipv4(value))return false;String[] p=value.split("\\.");int a=Integer.parseInt(p[0]),b=Integer.parseInt(p[1]);return a==10||(a==172&&b>=16&&b<=31)||(a==192&&b==168);}
private static boolean destination(String value){if("default".equals(value))return true;if(value==null)return false;String[] parts=value.split("/",-1);try{return parts.length==2&&ipv4(parts[0])&&Integer.parseInt(parts[1])>=0&&Integer.parseInt(parts[1])<=32;}catch(Exception ex){return false;}}
private static synchronized Properties properties(Path file)throws IOException{Properties values=new Properties();if(Files.isRegularFile(file))try(InputStream in=Files.newInputStream(file)){values.load(in);}return values;}
private static synchronized void store(Path file,Properties values,String comment)throws IOException{Files.createDirectories(file.getParent());Path temporary=Files.createTempFile(file.getParent(),file.getFileName().toString(),".tmp");try{try(OutputStream out=Files.newOutputStream(temporary)){values.store(out,comment);}try{Files.move(temporary,file,StandardCopyOption.ATOMIC_MOVE,StandardCopyOption.REPLACE_EXISTING);}catch(AtomicMoveNotSupportedException ex){Files.move(temporary,file,StandardCopyOption.REPLACE_EXISTING);}}finally{Files.deleteIfExists(temporary);}}
private static synchronized void request(File file,Properties values)throws IOException{file.getParentFile().mkdirs();File temporary=File.createTempFile(file.getName()+".",".tmp",file.getParentFile());try(Writer writer=new OutputStreamWriter(new FileOutputStream(temporary),"UTF-8")){values.store(writer,"FabricNavigator setup request");}try{Files.move(temporary.toPath(),file.toPath(),StandardCopyOption.ATOMIC_MOVE,StandardCopyOption.REPLACE_EXISTING);}catch(AtomicMoveNotSupportedException ex){Files.move(temporary.toPath(),file.toPath(),StandardCopyOption.REPLACE_EXISTING);}}
private static synchronized int routes(String[] destinations,String[] gateways)throws IOException{if(destinations==null||gateways==null||destinations.length!=gateways.length||destinations.length>64)throw new IllegalArgumentException("routes");LinkedHashMap<String,String> result=new LinkedHashMap<String,String>();Path file=SECURITY.resolve("static-routes.conf");if(Files.isRegularFile(file))for(String line:Files.readAllLines(file,StandardCharsets.UTF_8)){String[] pair=line.split("\\|",2);if(pair.length==2)result.put(pair[0],pair[1]);}int count=0;for(int i=0;i<destinations.length;i++){String network=p(destinations,i),gateway=p(gateways,i);if(network.length()==0&&gateway.length()==0)continue;if(!destination(network)||!ipv4(gateway))throw new IllegalArgumentException("routes");result.put(network,gateway);count++;}Files.createDirectories(file.getParent());List<String> lines=new ArrayList<String>();for(Map.Entry<String,String> route:result.entrySet())lines.add(route.getKey()+"|"+route.getValue());Files.write(file,lines,StandardCharsets.UTF_8,StandardOpenOption.CREATE,StandardOpenOption.TRUNCATE_EXISTING);return count;}
private static long ipv4Number(String value){String[] parts=value.split("\\.");long result=0;for(String part:parts)result=(result<<8)|Integer.parseInt(part);return result;}
private static LinkedHashSet<String> excludes(String raw){LinkedHashSet<String> result=new LinkedHashSet<String>();if(raw==null)return result;for(String token:raw.split("[,\\r\\n]+")){String value=token.trim();if(value.length()==0)continue;String address=value;int prefix=32,slash=value.indexOf('/');try{if(slash>=0){address=value.substring(0,slash).trim();prefix=Integer.parseInt(value.substring(slash+1).trim());}}catch(Exception ex){throw new IllegalArgumentException("excludes");}if(!ipv4(address)||prefix<8||prefix>32||result.size()>=256)throw new IllegalArgumentException("excludes");result.add(address+(prefix==32?"":"/"+prefix));}return result;}
private static LinkedHashSet<String> seeds(String raw){LinkedHashSet<String> result=new LinkedHashSet<String>();LinkedHashSet<Long> expanded=new LinkedHashSet<Long>();if(raw!=null)for(String token:raw.split("[,\\r\\n]+")){String value=token.trim();if(value.length()==0)continue;String address=value;int prefix=32,slash=value.indexOf('/');try{if(slash>=0){address=value.substring(0,slash).trim();prefix=Integer.parseInt(value.substring(slash+1).trim());}}catch(Exception ex){throw new IllegalArgumentException("seeds");}if(!ipv4(address)||prefix<24||prefix>32)throw new IllegalArgumentException("seeds");long input=ipv4Number(address),size=1L<<(32-prefix),network=input&~(size-1L);for(long offset=0;offset<size;offset++){expanded.add(network+offset);if(expanded.size()>256)throw new IllegalArgumentException("seeds");}result.add(address+(prefix==32?"":"/"+prefix));}if(result.isEmpty())throw new IllegalArgumentException("seeds");return result;}
