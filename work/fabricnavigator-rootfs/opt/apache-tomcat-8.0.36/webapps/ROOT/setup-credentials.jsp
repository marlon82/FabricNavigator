 List<String> snmpIds=new ArrayList<String>();for(int i=0;i<labels.length;i++){String label=p(labels,i),version=p(versions,i),community=p(communities,i),user=p(users,i),level=p(levels,i),auth=p(authProtocols,i),authPassword=p(authPasswords,i),privacy=p(privProtocols,i),privacyPassword=p(privPasswords,i),context=p(contexts,i);if(label.length()==0||!(version.equals("v1")||version.equals("v2c")||version.equals("v3")))throw new IllegalArgumentException("snmp");if(version.equals("v3")){if(user.length()==0||!(level.equals("noAuthNoPriv")||level.equals("authNoPriv")||level.equals("authPriv")))throw new IllegalArgumentException("snmp");if(!level.equals("noAuthNoPriv")&&(authPassword.length()<8||!(auth.equals("SHA")||auth.equals("MD5"))))throw new IllegalArgumentException("snmp");if(level.equals("authPriv")&&(privacyPassword.length()<8||!(privacy.equals("AES")||privacy.equals("DES")||privacy.equals("3DES"))))throw new IllegalArgumentException("snmp");community="";}else if(community.length()==0)throw new IllegalArgumentException("snmp");snmpIds.add(CredentialVault.saveSnmp("",label,version,community,"",user,level,auth,authPassword,privacy,privacyPassword,context));}
 String sshId,webId;try{sshId=CredentialVault.saveSsh("",request.getParameter("sshLabel"),request.getParameter("sshUser"),22,request.getParameter("sshPassword"),"","",true);}catch(Exception ex){throw new IllegalArgumentException("ssh");}try{webId=CredentialVault.saveSsh("",request.getParameter("webLabel"),request.getParameter("webUser"),443,request.getParameter("webPassword"),"","",false);}catch(Exception ex){throw new IllegalArgumentException("web");}Properties webIds=properties(WEB_PROFILE_IDS);webIds.setProperty(webId,"true");store(WEB_PROFILE_IDS,webIds,"FabricNavigator WebView credential IDs (no secrets)");Properties defaults=new Properties();defaults.setProperty("sshCredentialId",sshId);defaults.setProperty("webCredentialId",webId);store(DEFAULT_ASSIGNMENTS,defaults,"FabricNavigator default credential assignments (no secrets)");
 int routeCount=routes(request.getParameterValues("routeDestination"),request.getParameterValues("routeGateway"));Files.write(EXCLUDES,excluded,StandardCharsets.UTF_8,StandardOpenOption.CREATE,StandardOpenOption.TRUNCATE_EXISTING);
 String mode=request.getParameter("networkMode"),networkInterface=request.getParameter("networkInterface");if(networkInterface==null)networkInterface="";networkInterface=networkInterface.trim();if(!networkInterface.matches("[A-Za-z0-9_.: -]{0,80}")||!("dhcp".equals(mode)||"static".equals(mode)))throw new IllegalArgumentException("network");Properties network=new Properties();network.setProperty("mode",mode);network.setProperty("interface",networkInterface);if("static".equals(mode)){String address=request.getParameter("networkAddress"),prefix=request.getParameter("networkPrefix"),gateway=request.getParameter("networkGateway"),dns=request.getParameter("networkDns");int prefixValue;try{prefixValue=Integer.parseInt(prefix);}catch(Exception ex){throw new IllegalArgumentException("network");}if(!ipv4(address)||prefixValue<1||prefixValue>32||!ipv4(gateway))throw new IllegalArgumentException("network");if(dns==null)dns="";String[] dnsServers=dns.trim().length()==0?new String[0]:dns.split(",",-1);if(dnsServers.length>3)throw new IllegalArgumentException("network");for(String server:dnsServers)if(!ipv4(server.trim()))throw new IllegalArgumentException("network");network.setProperty("address",address);network.setProperty("prefix",prefix);network.setProperty("gateway",gateway);network.setProperty("dns",dns);}network.setProperty("notBefore",Long.toString(System.currentTimeMillis()+120000L));network.setProperty("requestedBy",actor);request(hostFile("host-network.request"),network);
