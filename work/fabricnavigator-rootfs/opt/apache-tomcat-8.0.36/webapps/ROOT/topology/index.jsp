private static boolean validDeviceIp(String value){if(value==null||!value.matches("^[0-9.]{7,15}$"))return false;String[] parts=value.split("\\.",-1);if(parts.length!=4)return false;int[] octets=new int[4];for(int i=0;i<parts.length;i++)try{if(parts[i].length()==0||(parts[i].length()>1&&parts[i].startsWith("0")))return false;octets[i]=Integer.parseInt(parts[i]);if(octets[i]<0||octets[i]>255)return false;}catch(Exception ex){return false;}return octets[0]>=1&&octets[0]<=223&&octets[0]!=127;}
private static boolean validPrivateDeviceIp(String value){return validDeviceIp(value);}
private static final Path DISCOVERY_EXCLUDES=Paths.get("/opt/fabricnavigator/data/discovery-excludes.txt"),DISCOVERY_LOG=Paths.get("/opt/fabricnavigator/data/discovery.log"),DEFAULT_ASSIGNMENTS=Paths.get("/opt/fabricnavigator/data/default-credential-assignments.properties"),WEB_ASSIGNMENTS=Paths.get("/opt/fabricnavigator/data/webview-assignments.properties"),WEB_PROFILE_IDS=Paths.get("/opt/fabricnavigator/data/webview-profile-ids.properties");
