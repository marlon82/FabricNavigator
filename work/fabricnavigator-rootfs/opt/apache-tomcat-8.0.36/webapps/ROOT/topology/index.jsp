private static boolean excludedIp(String ip,List<String> rules){if(!validPrivateDeviceIp(ip))return false;long address=ipv4Number(ip);for(String raw:rules){String rule=raw==null?"":raw.trim();if(rule.length()==0)continue;String network=rule;int prefix=32,slash=rule.indexOf('/');try{if(slash>=0){network=rule.substring(0,slash).trim();prefix=Integer.parseInt(rule.substring(slash+1).trim());}if(!validPrivateDeviceIp(network)||prefix<0||prefix>32)continue;long mask=prefix==0?0:(0xffffffffL<<(32-prefix))&0xffffffffL;if((address&mask)==(ipv4Number(network)&mask))return true;}catch(Exception ignored){}}return false;}
private static void filterExcluded(TopologyDiscoveryV7.Result result,List<String> rules){if(result==null||rules.isEmpty())return;Set<String> removed=new HashSet<String>();for(Iterator<TopologyDiscoveryV7.Node> it=result.nodes.iterator();it.hasNext();){TopologyDiscoveryV7.Node node=it.next();if(excludedIp(node.ip,rules)){removed.add(node.id);it.remove();}}for(Iterator<TopologyDiscoveryV7.Link> it=result.links.iterator();it.hasNext();){TopologyDiscoveryV7.Link link=it.next();if(removed.contains(link.source)||removed.contains(link.target))it.remove();}if(!removed.isEmpty())result.warnings.add("Discovery exclusions applied: "+removed.size()+" device(s) omitted.");}
private static Properties loadProperties(Path path){Properties p=new Properties();try{if(Files.isRegularFile(path))try(InputStream in=Files.newInputStream(path)){p.load(in);}}catch(Exception ignored){}return p;}
