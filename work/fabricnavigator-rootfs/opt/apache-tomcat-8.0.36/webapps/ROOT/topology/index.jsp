private static Map<String,String> verifiedSnmpAssignments(TopologyDiscoveryV7.Result result,String[] selectedSnmpIds){Map<String,String> verified=new HashMap<String,String>();if(result==null||selectedSnmpIds==null)return verified;LinkedHashMap<String,TopologyDiscoveryV7.Credential> credentials=new LinkedHashMap<String,TopologyDiscoveryV7.Credential>();Map<String,List<String>> byLabel=new HashMap<String,List<String>>();for(String id:selectedSnmpIds)try{if(id==null||credentials.containsKey(id))continue;TopologyDiscoveryV7.Credential credential=managedCredential(id);credentials.put(id,credential);String label=discoveryCredentialLabel(credential);if(label.length()>0){if(!byLabel.containsKey(label))byLabel.put(label,new ArrayList<String>());byLabel.get(label).add(id);}}catch(Exception ignored){}for(TopologyDiscoveryV7.Node node:result.nodes){if(!actionableDevice(node))continue;String reported=node.credential==null?"":node.credential.trim();List<String> candidates=byLabel.get(reported);if(candidates!=null&&candidates.size()==1){verified.put(node.ip,candidates.get(0));continue;}Collection<String> probeIds=candidates!=null&&!candidates.isEmpty()?candidates:credentials.keySet();for(String id:probeIds){SnmpUtilV3 snmp=null;try{snmp=discoverySession(node.ip,Collections.singletonList(credentials.get(id)));if(snmp!=null){verified.put(node.ip,id);break;}}catch(Exception ignored){}finally{if(snmp!=null)try{snmp.closeSession();}catch(Exception ignored){}}}}return verified;}
