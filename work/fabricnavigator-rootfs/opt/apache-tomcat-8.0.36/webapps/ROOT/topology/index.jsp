private static boolean usefulDeviceName(String value){String normalized=physicalIdentity(value);return normalized.length()>=3&&!oneOf(normalized,"unknown","device","switch","router","firewall","phone","accesspoint","ap");}
private static List<String> physicalNodeKeys(TopologyDiscoveryV7.Node node){LinkedHashSet<String> keys=new LinkedHashSet<String>();if(node==null)return new ArrayList<String>();if(validPrivateDeviceIp(node.ip))keys.add("ip:"+node.ip);String chassis=physicalIdentity(node.chassis);if(chassis.length()>=6)keys.add("chassis:"+chassis);if(usefulDeviceName(node.name))keys.add("name:"+physicalIdentity(node.name));String id=physicalIdentity(node.id);if(id.length()>=6&&!validPrivateDeviceIp(node.id)&&!oneOf(id,"unknown","device","switch","router","firewall","phone","accesspoint"))keys.add("id:"+id);return new ArrayList<String>(keys);}
