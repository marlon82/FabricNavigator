private static boolean macAddressPort(String value){String normalized=value==null?"":value.trim();return normalized.matches("(?i)^(?:[0-9a-f]{2}[:-]){5}[0-9a-f]{2}$")||normalized.matches("(?i)^[0-9a-f]{12}$");}
private static int learnedPortQuality(String value){String normalized=value==null?"":value.trim();if(normalized.length()==0||"?".equals(normalized)||"unknown".equalsIgnoreCase(normalized))return 0;if(macAddressPort(normalized))return 1;if(normalized.matches("^(?:\\d{1,3}\\.){3}\\d{1,3}$"))return 2;return 3;}
