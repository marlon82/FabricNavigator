private static String encoded(String value){return Base64.getEncoder().encodeToString((value==null?"":value).getBytes(StandardCharsets.UTF_8));}
private static boolean probeSsh(String ip,Properties ssh)throws Exception{Process process=new ProcessBuilder("/usr/bin/perl","/opt/fabricnavigator/ssh-probe.pl").redirectErrorStream(true).start();BufferedWriter input=new BufferedWriter(new OutputStreamWriter(process.getOutputStream(),StandardCharsets.UTF_8));try{input.write(encoded(ip));input.newLine();input.write(encoded(ssh.getProperty("username","")));input.newLine();input.write(encoded(ssh.getProperty("sshPassword","")));input.newLine();input.write(encoded(ssh.getProperty("sshPrivateKey","")));input.newLine();input.write(encoded(ssh.getProperty("sshKeyPassphrase","")));input.newLine();input.write(ssh.getProperty("port","22"));input.newLine();}finally{input.close();}boolean finished=process.waitFor(9,TimeUnit.SECONDS);if(!finished){process.destroyForcibly();return false;}return process.exitValue()==0;}
