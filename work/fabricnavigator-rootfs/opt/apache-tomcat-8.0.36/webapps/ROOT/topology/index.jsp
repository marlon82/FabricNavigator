private static String ipv4Text(long value){return ((value>>>24)&255)+"."+((value>>>16)&255)+"."+((value>>>8)&255)+"."+(value&255);}
private static void addDiscoverySeedExpression(LinkedHashSet<String> unique,String expression){int slash=expression.indexOf('/');if(slash<0){if(!validPrivateDeviceIp(expression)||unique.size()>=256)throw new IllegalArgumentException("invalidSeeds");unique.add(expression);return;}if(slash==0||slash!=expression.lastIndexOf('/'))throw new IllegalArgumentException("invalidSeeds");String addressText=expression.substring(0,slash).trim();int prefix;try{prefix=Integer.parseInt(expression.substring(slash+1).trim());}catch(Exception ex){throw new IllegalArgumentException("invalidSeeds");}if(!validPrivateDeviceIp(addressText)||prefix<24||prefix>32)throw new IllegalArgumentException("invalidSeeds");long mask=prefix==0?0:(0xffffffffL<<(32-prefix))&0xffffffffL,network=ipv4Number(addressText)&mask,broadcast=network|(~mask&0xffffffffL),first=prefix<=30?network+1:network,last=prefix<=30?broadcast-1:broadcast;if(last<first||last-first+1>256)throw new IllegalArgumentException("invalidSeeds");for(long address=first;address<=last;address++){String seed=ipv4Text(address);if(!validPrivateDeviceIp(seed)||unique.size()>=256&&!unique.contains(seed))throw new IllegalArgumentException("invalidSeeds");unique.add(seed);}}
private static List<String> discoverySeeds(String value){LinkedHashSet<String> unique=new LinkedHashSet<String>();if(value!=null)for(String item:value.split(",")){String seed=item.trim();if(seed.length()>0)addDiscoverySeedExpression(unique,seed);}if(unique.isEmpty()||unique.size()>256)throw new IllegalArgumentException("invalidSeeds");return new ArrayList<String>(unique);}
private static String nodeKey(TopologyDiscoveryV7.Node node){if(node==null)return "";return node.id==null||node.id.length()==0?node.ip:node.id;}
private static String linkKey(TopologyDiscoveryV7.Link link){if(link==null)return "";String a=(link.source==null?"":link.source)+"|"+(link.sourcePort==null?"":link.sourcePort),b=(link.target==null?"":link.target)+"|"+(link.targetPort==null?"":link.targetPort);return a.compareTo(b)<=0?a+"<>"+b:b+"<>"+a;}
