function cleanText(v,max){return typeof v==='string'?v.slice(0,max||256):'';}
function normalizedPhysicalPort(value){return cleanText(value,120).toLowerCase().replace(/^(?:port|ethernet|gigabit(?:ethernet)?|ten-gigabit(?:ethernet)?|interface)\s*/, '').replace(/[^a-z0-9]+/g,'');}
function learnedPortQuality(value){var text=cleanText(value,120).trim();if(!text||text==='?'||text.toLowerCase()==='unknown')return 0;if(/^(?:[0-9a-f]{2}[:-]){5}[0-9a-f]{2}$/i.test(text)||/^[0-9a-f]{12}$/i.test(text))return 1;if(/^(?:\d{1,3}\.){3}\d{1,3}$/.test(text))return 2;return 3;}
