private static String decodedLldpDescription(String value){if(value==null)return "";int start=value.indexOf("0x");if(start<0)return value;StringBuilder decoded=new StringBuilder();for(String token:value.substring(start+2).split(":")){if(token.length()<2)break;try{decoded.append((char)Integer.parseInt(token.substring(0,2),16));}catch(Exception ex){break;}}return value+" "+decoded.toString();}
private static String deviceType(String name,String id,String description){String v=((name==null?"":name)+" "+(id==null?"":id)+" "+decodedLldpDescription(description)).toLowerCase(Locale.ENGLISH);if(v.contains("ip phone")||v.contains("ip-phone")||v.contains("deskphone")||v.contains("telephone")||v.contains("voip")||v.contains("avaya j")||v.contains("avaya vantage")||v.matches(".*avaya 96[0-9]{2}.*")||v.contains("polycom")||v.contains("yealink")||v.contains("grandstream")||v.contains("snom")||v.contains("cisco ip phone")||v.contains("cisco cp-"))return "phone";if(v.matches(".*(?:^|[ _-])ap[0-9_-].*")||v.contains("access point")||v.contains("wireless")||v.contains("wlan"))return "accesspoint";if(v.contains("fortigate")||v.contains("firewall")||v.contains("pfsense")||v.contains("opnsense"))return "firewall";if(switchOperatingSystem(description)||v.matches(".*(?:^|[ _-])sw[ _-].*")||v.contains("switch"))return "switch";if(v.contains("router")||v.contains("gateway"))return "router";return "other";}
private static TopologyDiscoveryV7.Credential managedCredential(String id)throws Exception{Properties v=CredentialVault.getCredential(id);if(!CredentialVault.TYPE_SNMP.equals(v.getProperty("type")))throw new IllegalArgumentException("invalidCredential");TopologyDiscoveryV7.Credential c=new TopologyDiscoveryV7.Credential();c.version=v.getProperty("version","");c.community=v.getProperty("roCommunity","");c.user=v.getProperty("username","");c.level=v.getProperty("securityLevel","");c.authProtocol=v.getProperty("authProtocol","");c.authPassword=v.getProperty("v3AuthPassword","");c.privProtocol=v.getProperty("privProtocol","");c.privPassword=v.getProperty("v3PrivPassword","");c.context=v.getProperty("context","");return c;}
