private static void deduplicateResult(TopologyDiscoveryV7.Result result){if(result==null)return;Map<String,TopologyDiscoveryV7.Node> byIdentity=new LinkedHashMap<String,TopologyDiscoveryV7.Node>();Map<String,String> aliases=new HashMap<String,String>();List<TopologyDiscoveryV7.Node> uniqueNodes=new ArrayList<TopologyDiscoveryV7.Node>();int removedNodes=0;for(TopologyDiscoveryV7.Node node:result.nodes){TopologyDiscoveryV7.Node canonical=null;List<String> keys=physicalNodeKeys(node);for(String key:keys){canonical=byIdentity.get(key);if(canonical!=null)break;}if(canonical==null){uniqueNodes.add(node);canonical=node;}else if(canonical!=node){mergeNode(canonical,node);aliases.put(node.id,canonical.id);removedNodes++;}for(String key:physicalNodeKeys(canonical))byIdentity.put(key,canonical);for(String key:keys)byIdentity.put(key,canonical);}if(removedNodes>0){result.nodes.clear();result.nodes.addAll(uniqueNodes);}Map<String,TopologyDiscoveryV7.Link> exactLinks=new LinkedHashMap<String,TopologyDiscoveryV7.Link>(),physicalLinks=new LinkedHashMap<String,TopologyDiscoveryV7.Link>();List<TopologyDiscoveryV7.Link> uniqueLinks=new ArrayList<TopologyDiscoveryV7.Link>();int removedLinks=0;for(TopologyDiscoveryV7.Link link:result.links){while(aliases.containsKey(link.source))link.source=aliases.get(link.source);while(aliases.containsKey(link.target))link.target=aliases.get(link.target);if(Objects.equals(link.source,link.target)){removedLinks++;continue;}String exact=linkKey(link),forward=directedPhysicalLinkKey(link.source,link.sourcePort,link.target),reverse=directedPhysicalLinkKey(link.target,link.targetPort,link.source);TopologyDiscoveryV7.Link existing=exactLinks.get(exact);if(existing==null)existing=physicalLinks.get(forward);if(existing==null)existing=physicalLinks.get(reverse);if(existing==null){uniqueLinks.add(link);exactLinks.put(exact,link);physicalLinks.put(forward,link);physicalLinks.put(reverse,link);}else{mergeDiscoveredLink(existing,link);exactLinks.put(linkKey(existing),existing);physicalLinks.put(directedPhysicalLinkKey(existing.source,existing.sourcePort,existing.target),existing);physicalLinks.put(directedPhysicalLinkKey(existing.target,existing.targetPort,existing.source),existing);removedLinks++;}}if(removedLinks>0){result.links.clear();result.links.addAll(uniqueLinks);}if(removedNodes>0||removedLinks>0)result.warnings.add("Duplicate discovery records merged: "+removedNodes+" node(s), "+removedLinks+" link(s).");}
private static List<String> responsiveDiscoverySeeds(List<String> seeds,final List<TopologyDiscoveryV7.Credential> credentials,List<String> excludes)throws Exception{final List<String> candidates=new ArrayList<String>();for(String seed:seeds)if(!excludedIp(seed,excludes))candidates.add(seed);if(candidates.isEmpty())throw new IllegalArgumentException("excludedSeed");if(candidates.size()<=8)return candidates;int workers=Math.min(32,candidates.size());ExecutorService executor=Executors.newFixedThreadPool(workers);List<Future<String>> probes=new ArrayList<Future<String>>();try{for(final String seed:candidates)probes.add(executor.submit(new Callable<String>(){public String call(){SnmpUtilV3 snmp=null;try{snmp=discoverySession(seed,credentials);return snmp==null?null:seed;}catch(Exception ignored){return null;}finally{if(snmp!=null)try{snmp.closeSession();}catch(Exception ignored){}}}}));LinkedHashSet<String> responsive=new LinkedHashSet<String>();for(Future<String> probe:probes){String seed=probe.get();if(seed!=null)responsive.add(seed);}return new ArrayList<String>(responsive);}finally{executor.shutdownNow();}}
private static TopologyDiscoveryV7.Result discoverMultiple(String value,List<TopologyDiscoveryV7.Credential> credentials)throws Exception{List<String> requestedSeeds=discoverySeeds(value),excludes=discoveryExcludes(),seeds=responsiveDiscoverySeeds(requestedSeeds,credentials,excludes);if(seeds.isEmpty()){TopologyDiscoveryV7.Result empty=new TopologyDiscoveryV7.Result();empty.warnings.add("No seed address responded to the selected SNMP profiles.");return empty;}TopologyDiscoveryV7.Result merged=null;Set<String> nodes=new LinkedHashSet<String>(),links=new LinkedHashSet<String>(),discoveredAddresses=new HashSet<String>();for(String seed:seeds){if(discoveredAddresses.contains(seed))continue;TopologyDiscoveryV7.Result current=new TopologyDiscoveryV7().discover(seed,credentials);filterExcluded(current,excludes);for(TopologyDiscoveryV7.Node node:current.nodes)if(validPrivateDeviceIp(node.ip))discoveredAddresses.add(node.ip);if(merged==null){merged=current;for(TopologyDiscoveryV7.Node node:merged.nodes)nodes.add(nodeKey(node));for(TopologyDiscoveryV7.Link link:merged.links)links.add(linkKey(link));continue;}for(TopologyDiscoveryV7.Node node:current.nodes){String key=nodeKey(node);if(nodes.size()>=256)break;if(key.length()>0&&nodes.add(key))merged.nodes.add(node);}for(TopologyDiscoveryV7.Link link:current.links){String key=linkKey(link);if(key.length()>0&&nodes.contains(link.source)&&nodes.contains(link.target)&&links.add(key))merged.links.add(link);}merged.warnings.addAll(current.warnings);}if(merged==null)throw new IllegalArgumentException("excludedSeed");deduplicateResult(merged);return merged;}
