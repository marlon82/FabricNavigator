color:#667085;font-size:13px;line-height:1.5}.secret-note{background:#f5f0ff;border-left:4px solid #8d25e8;padding:12px}.hidden{display:none!important}.audit{font-size:12px;min-width:980px}.fn-audit-table td{line-height:1.45}.fn-audit-table td:first-child,.fn-audit-table td:nth-child(2),.fn-audit-table td:last-child{white-space:nowrap}.fn-audit-table td:nth-child(4){min-width:180px}.fn-audit-table td:nth-child(4) small{display:block;margin-top:3px;color:#7b8191;font:10px/1.3 ui-monospace,SFMono-Regular,Consolas,monospace}.fn-audit-detail{min-width:320px;white-space:normal;overflow-wrap:anywhere}.fn-audit-result{display:inline-flex;padding:4px 8px;border-radius:999px;font-weight:800;background:#e7f8ee;color:#17683a}.fn-audit-failed .fn-audit-result{background:#fdeaea;color:#a4262c}.alert{width:min(100% - 32px,1440px);margin:18px auto}@media(max-width:900px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}.form-grid,.bulk-panel,.bulk-panel.hostkeys{grid-template-columns:1fr}.full{grid-column:auto}.topbar-inner{flex-wrap:wrap;padding:12px 0}.logo{width:150px}}
</style></head><body><header class="topbar"><div class="topbar-inner"><img class="logo" src="/assets/FabricNavigator_modern_schwarz.png" alt="FabricNavigator"><a class="button navlink" href="/devices/">Devices</a><a class="button navlink" href="/topology/">Topologie</a><form class="logout" method="post" action="/logout.jsp"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><button class="danger" type="submit">Abmelden</button></form></div></header><%if(flash!=null){%><div class="alert success" data-fn-alert-target="<%=h(flashTarget)%>"><%=h(flash)%></div><%}if(error!=null){%><div class="alert error" data-fn-alert-target="<%=h(flashTarget)%>"><%=h(error)%></div><%}%><main class="page"><div class="grid">
<section class="card wide"><h2>Benutzerverwaltung</h2><div class="scroll"><table><thead><tr><th>Benutzer</th><th>Rolle</th><th>Status</th><th>Rolle ändern</th><th>Passwort zurücksetzen</th><th>Aktionen</th></tr></thead><tbody><%for(EdmSecurity.User u:users){%><tr><td><strong><%=h(u.username)%></strong><%=actor.equals(u.username)?" (Sie)":""%></td><td><span class="badge"><%=h(u.role)%></span></td><td><%=u.enabled?"Aktiv":"Gesperrt"%></td><td><form class="actions" method="post"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="setUserRole"><input type="hidden" name="username" value="<%=h(u.username)%>"><select name="role" <%=actor.equals(u.username)?"disabled":""%>><option value="USER" <%="USER".equals(u.role)?"selected":""%>>Benutzer</option><option value="ADMIN" <%="ADMIN".equals(u.role)?"selected":""%>>Admin</option></select><button type="submit" <%=actor.equals(u.username)?"disabled":""%>>Speichern</button></form></td><td><form class="actions" method="post" autocomplete="off"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="resetPassword"><input type="hidden" name="username" value="<%=h(u.username)%>"><input name="password" type="password" minlength="6" maxlength="128" required autocomplete="new-password" placeholder="Neues Passwort"><button type="submit">Setzen</button></form></td><td><div class="actions"><%if(!actor.equals(u.username)){%><form method="post"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="setUserEnabled"><input type="hidden" name="username" value="<%=h(u.username)%>"><input type="hidden" name="enabled" value="<%=u.enabled?"false":"true"%>"><button class="muted-button" type="submit"><%=u.enabled?"Sperren":"Aktivieren"%></button></form><form method="post" onsubmit="return confirm('Benutzer wirklich löschen?')"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="deleteUser"><input type="hidden" name="username" value="<%=h(u.username)%>"><button class="danger" type="submit">Löschen</button></form><%}%></div></td></tr><%}%></tbody></table></div><h3>Neuen Benutzer anlegen</h3><form class="form-grid" method="post" autocomplete="off"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="createUser"><label>Benutzername<input name="username" required pattern="[A-Za-z0-9._-]{3,32}" maxlength="32" autocomplete="off"></label><label>Rolle<select name="role"><option value="USER">Benutzer</option><option value="ADMIN">Admin</option></select></label><label>Initiales Passwort<input name="password" type="password" required minlength="6" maxlength="128" autocomplete="new-password"></label><div class="actions"><button type="submit">Benutzer anlegen</button></div></form></section>
<section class="card"><h2>SNMP-Credentials</h2><p class="secret-note">Communities und SNMPv3-Passphrasen werden mit AES-GCM verschlüsselt. Leere Geheimnisfelder erhalten beim Aktualisieren den bestehenden Wert.</p><form class="form-grid" method="post" autocomplete="off" id="snmp-form"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="saveSnmp"><label class="full">Profil aktualisieren (optional)<select name="credentialId" id="snmp-existing"><option value="">Neues Profil</option><%for(CredentialVault.Metadata m:snmpProfiles){%><option value="<%=h(m.id)%>" data-label="<%=h(m.label)%>" data-version="<%=h(m.version)%>" data-user="<%=h(m.username)%>" data-level="<%=h(m.securityLevel)%>" data-auth="<%=h(m.authProtocol)%>" data-priv="<%=h(m.privProtocol)%>" data-context="<%=h(m.context)%>"><%=h(m.label)%></option><%}%></select></label><label>Bezeichnung<input name="label" required maxlength="80"></label><label>Version<select name="version" id="snmp-version"><option value="v1">SNMPv1</option><option value="v2c" selected>SNMPv2c</option><option value="v3">SNMPv3</option></select></label><label class="community-field">Read Community<input name="roCommunity" type="password" autocomplete="new-password"></label><label class="community-field">Write Community (optional)<input name="rwCommunity" type="password" autocomplete="new-password"></label><label class="v3-field hidden">SNMPv3-Benutzer<input name="v3User" autocomplete="off"></label><label class="v3-field hidden">Security Level<select name="v3SecurityLevel"><option>noAuthNoPriv</option><option>authNoPriv</option><option selected>authPriv</option></select></label><label class="v3-field hidden">Auth-Protokoll<select name="v3AuthProtocol"><option>SHA</option><option>MD5</option></select></label><label class="v3-field hidden">Auth-Passphrase<input name="v3AuthPassword" type="password" autocomplete="new-password"></label><label class="v3-field hidden">Privacy-Protokoll<select name="v3PrivProtocol"><option>AES</option><option>DES</option><option>3DES</option></select></label><label class="v3-field hidden">Privacy-Passphrase<input name="v3PrivPassword" type="password" autocomplete="new-password"></label><label class="v3-field hidden full">Kontext (optional)<input name="v3Context"></label><div class="actions full"><button type="submit">SNMP-Profil speichern</button></div></form><h3>Vorhanden</h3><div class="scroll"><table><thead><tr><th>Profil</th><th>Version</th><th>Aktion</th></tr></thead><tbody><%for(CredentialVault.Metadata m:snmpProfiles){%><tr><td><%=h(m.label)%></td><td><%=h(m.version)%></td><td><form method="post" onsubmit="return confirm('Nicht zugewiesenes Profil löschen?')"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="deleteCredential"><input type="hidden" name="credentialId" value="<%=h(m.id)%>"><button class="danger small" type="submit">Löschen</button></form></td></tr><%}%></tbody></table></div></section>
<section class="card"><h2>SSH-Credentials</h2><p class="secret-note">Passwort oder privater Schlüssel werden nur serverseitig entschlüsselt. Host-Key-Prüfung bleibt zwingend aktiv.</p><form class="form-grid" method="post" autocomplete="off" id="ssh-form"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="saveSsh"><label class="full">Profil aktualisieren (optional)<select name="credentialId" id="ssh-existing"><option value="">Neues Profil</option><%for(CredentialVault.Metadata m:sshProfiles){%><option value="<%=h(m.id)%>" data-label="<%=h(m.label)%>" data-user="<%=h(m.username)%>" data-port="<%=m.port%>" data-enabled="<%=m.enabled%>"><%=h(m.label)%></option><%}%></select></label><label>Bezeichnung<input name="label" required maxlength="80"></label><label>SSH-Benutzer<input name="sshUser" required maxlength="64" autocomplete="off"></label><label>Port<input name="sshPort" type="number" min="1" max="65535" value="22" required></label><label class="actions"><input name="sshEnabled" type="checkbox" value="true" checked> Für Webterminal freigegeben</label><label>Passwort<input name="sshPassword" type="password" autocomplete="new-password"></label><label>Key-Passphrase (optional)<input name="sshKeyPassphrase" type="password" autocomplete="new-password"></label><label class="full">Privater OpenSSH-/PEM-Schlüssel (alternativ zum Passwort)<textarea name="sshPrivateKey" autocomplete="off" spellcheck="false"></textarea></label><div class="actions full"><button type="submit">SSH-Profil speichern</button></div></form><h3>Vorhanden</h3><div class="scroll"><table><thead><tr><th>Profil</th><th>Benutzer</th><th>Port</th><th>Status</th><th>Aktion</th></tr></thead><tbody><%for(CredentialVault.Metadata m:sshProfiles){%><tr><td><%=h(m.label)%></td><td><%=h(m.username)%></td><td><%=m.port%></td><td><%=m.enabled?"Freigegeben":"Deaktiviert"%></td><td><form method="post" onsubmit="return confirm('Nicht zugewiesenes Profil löschen?')"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="deleteCredential"><input type="hidden" name="credentialId" value="<%=h(m.id)%>"><button class="danger small" type="submit">Löschen</button></form></td></tr><%}%></tbody></table></div></section>
<section class="card wide"><h2>Gerätezuordnung</h2><p class="secret-note">Wähle mehrere Geräte aus und weise SNMP-, SSH- oder WebView-Zugangsdaten unabhängig voneinander zu. Nicht ausgewählte Zugangsarten bleiben unverändert.</p><div class="fn-assignment-bulk"><form class="bulk-panel bulk-credential-form" method="post" onsubmit="return fnCollectSelection(this,'.fn-device-select')"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="assignCredentialDevices"><input type="hidden" name="credentialType" value="snmp"><label>SNMP-Profil<select name="credentialId" required><option value="">Bitte wählen</option><%for(CredentialVault.Metadata m:snmpProfiles){%><option value="<%=h(m.id)%>"><%=h(m.label)%></option><%}%></select></label><button type="submit">SNMP zuweisen</button></form><form class="bulk-panel bulk-credential-form" method="post" onsubmit="return fnCollectSelection(this,'.fn-device-select')"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="assignCredentialDevices"><input type="hidden" name="credentialType" value="ssh"><label>SSH-Profil<select name="credentialId"><option value="">SSH-Zuweisung entfernen</option><%for(CredentialVault.Metadata m:sshProfiles){%><option value="<%=h(m.id)%>"><%=h(m.label)%></option><%}%></select></label><button type="submit">SSH zuweisen</button></form><form class="bulk-panel bulk-credential-form" method="post" onsubmit="return fnCollectSelection(this,'.fn-device-select')"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="assignCredentialDevices"><input type="hidden" name="credentialType" value="web"><label>WebView-Profil<select name="credentialId"><option value="">WebView-Zuweisung entfernen</option><%for(CredentialVault.Metadata m:webProfiles){%><option value="<%=h(m.id)%>"><%=h(m.label)%></option><%}%></select></label><button type="submit">WebView zuweisen</button></form></div><label class="fn-admin-table-search"><span>Geräte nach IP oder Name suchen</span><input type="search" autocomplete="off" data-filter-table="device-assignments" placeholder="IP oder Gerätename"></label><div class="scroll"><table class="fn-managed-device-table" data-managed-table="device-assignments"><thead><tr><th class="select-cell"><input type="checkbox" aria-label="Alle sichtbaren Geräte auswählen" onclick="fnToggleVisibleSelection(this,'.fn-device-select')"></th><th><button type="button" class="fn-sort-button" data-sort="ip">IP-Adresse</button></th><th><button type="button" class="fn-sort-button" data-sort="name">Gerätename</button></th><th>SNMP-Profil</th><th>SSH-Profil</th><th>WebView-Profil</th><th></th></tr></thead><tbody><%for(String ip:devices){String assignedSnmp="",assignedSsh="",assignedWebId=assignedWeb(webAssigned,ip),formId="fn-device-"+ip.replace('.','-');try{assignedSnmp=CredentialVault.getDeviceCredentialId(ip,CredentialVault.TYPE_SNMP);assignedSsh=CredentialVault.getDeviceCredentialId(ip,CredentialVault.TYPE_SSH);}catch(Exception ignored){}%><tr data-ip="<%=h(ip)%>" data-name=""><td class="select-cell"><input class="fn-device-select" type="checkbox" value="<%=h(ip)%>" aria-label="<%=h(ip)%> auswählen"><form id="<%=h(formId)%>" method="post"><input type="hidden" name="deviceIp" value="<%=h(ip)%>"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="assignDevice"></form></td><td><strong><%=h(ip)%></strong></td><td><span class="fn-managed-device-name">—</span></td><td><select form="<%=h(formId)%>" name="snmpCredentialId" required><option value="">Bitte wählen</option><%for(CredentialVault.Metadata m:snmpProfiles){%><option value="<%=h(m.id)%>" <%=m.id.equals(assignedSnmp)?"selected":""%>><%=h(m.label)%></option><%}%></select></td><td><select form="<%=h(formId)%>" name="sshCredentialId"><option value="">Kein Webterminal</option><%for(CredentialVault.Metadata m:sshProfiles){%><option value="<%=h(m.id)%>" <%=m.id.equals(assignedSsh)?"selected":""%>><%=h(m.label)%></option><%}%></select></td><td><select form="<%=h(formId)%>" name="webCredentialId"><option value="">Keine automatische Anmeldung</option><%for(CredentialVault.Metadata m:webProfiles){%><option value="<%=h(m.id)%>" <%=m.id.equals(assignedWebId)?"selected":""%>><%=h(m.label)%></option><%}%></select></td><td><button form="<%=h(formId)%>" type="submit">Zuweisen</button></td></tr><%}%></tbody></table></div></section>
<section class="card wide"><h2>SSH-Hostschlüssel</h2><p class="secret-note">Wähle mehrere Geräte aus, prüfe ihre Hostschlüssel und gib die unabhängig verglichenen Fingerprints anschließend gemeinsam frei. Nicht erreichbare Geräte verhindern die Verarbeitung der übrigen Auswahl nicht.</p><div class="bulk-panel hostkeys"><span class="hint">Die Prüfung kann je nach Anzahl der Geräte einige Sekunden dauern.</span><form method="post" onsubmit="return fnCollectSelection(this,'.fn-hostkey-select')"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="scanHostKeys"><button class="muted-button" type="submit">Auswahl prüfen</button></form><form method="post" onsubmit="return fnCollectSelection(this,'.fn-hostkey-select')&&confirm('Alle ausgewählten, unabhängig geprüften Fingerprints freigeben?')"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="approveHostKeys"><button type="submit">Auswahl freigeben</button></form></div><label class="fn-admin-table-search"><span>Geräte nach IP oder Name suchen</span><input type="search" autocomplete="off" data-filter-table="host-keys" placeholder="IP oder Gerätename"></label><div class="scroll"><table class="fn-managed-device-table" data-managed-table="host-keys"><thead><tr><th class="select-cell"><input type="checkbox" aria-label="Alle sichtbaren Hostschlüssel auswählen" onclick="fnToggleVisibleSelection(this,'.fn-hostkey-select')"></th><th><button type="button" class="fn-sort-button" data-sort="ip">IP-Adresse</button></th><th><button type="button" class="fn-sort-button" data-sort="name">Gerätename</button></th><th>Port</th><th>Freigegebener Fingerprint</th><th>Neu geprüft</th><th>Aktion</th></tr></thead><tbody><%for(String ip:devices){String sshId="";try{sshId=CredentialVault.getDeviceCredentialId(ip,CredentialVault.TYPE_SSH);}catch(Exception ignored){}if(sshId.length()==0)continue;CredentialVault.Metadata meta=CredentialVault.getMetadata(sshId);String approved="";try{approved=KnownHostsManager.approvedFingerprint(ip,meta.port);}catch(Exception ignored){}Object pendingObject=session.getAttribute("pendingHostKey."+ip);KnownHostsManager.Pending pending=pendingObject instanceof KnownHostsManager.Pending?(KnownHostsManager.Pending)pendingObject:null;%><tr data-ip="<%=h(ip)%>" data-name=""><td class="select-cell"><input class="fn-hostkey-select" type="checkbox" value="<%=h(ip)%>" aria-label="<%=h(ip)%> auswählen"></td><td><strong><%=h(ip)%></strong></td><td><span class="fn-managed-device-name">—</span></td><td><%=meta.port%></td><td><%=approved.length()>0?h(approved):"Nicht freigegeben"%></td><td><%=pending==null?"—":h(pending.keyType+" · "+pending.fingerprint)%></td><td><div class="actions"><form method="post"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="scanHostKey"><input type="hidden" name="deviceIp" value="<%=h(ip)%>"><button class="muted-button" type="submit">Hostschlüssel prüfen</button></form><%if(pending!=null){%><form method="post" onsubmit="return confirm('Fingerprint unabhängig geprüft und freigeben?')"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="approveHostKey"><input type="hidden" name="deviceIp" value="<%=h(ip)%>"><button type="submit">Fingerprint freigeben</button></form><%}%></div></td></tr><%}%></tbody></table></div></section>
<section class="card wide"><h2>Auditprotokoll</h2><p class="secret-note">Die letzten 100 sicherheits- und konfigurationsrelevanten Vorgänge mit den betroffenen Objekten und nicht-geheimen Änderungsdetails. Passwörter, Communities, Tokens und private Schlüssel werden niemals protokolliert.</p><div class="scroll"><table class="audit fn-audit-table"><thead><tr><th>Zeit</th><th>Benutzer</th><th>Ergebnis</th><th>Vorgang</th><th>Änderungsdetails</th><th>Quelladresse</th></tr></thead><tbody><%for(String[] row:audit){String rawAction=row.length>2?row[2]:"",result=rawAction.startsWith("FAILED_")?"Fehlgeschlagen":"Erfolgreich";%><tr class="<%=rawAction.startsWith("FAILED_")?"fn-audit-failed":"fn-audit-success"%>"><td><%=h(row.length>0?row[0]:"")%></td><td><%=h(row.length>1?row[1]:"")%></td><td><span class="fn-audit-result"><%=result%></span></td><td><strong><%=h(auditActionLabel(rawAction))%></strong><small><%=h(rawAction)%></small></td><td class="fn-audit-detail"><%=h(row.length>3?row[3]:"")%></td><td><%=h(row.length>4?row[4]:"")%></td></tr><%}%></tbody></table></div></section>
</div></main><script>function fnToggleSelection(source,selector){document.querySelectorAll(selector).forEach(function(box){box.checked=source.checked;});}function fnCollectSelection(form,selector){form.querySelectorAll('input[data-fn-selection]').forEach(function(input){input.remove();});var selected=document.querySelectorAll(selector+':checked');if(!selected.length){alert(document.documentElement.lang==='en'?'Select at least one device.':'Wähle mindestens ein Gerät aus.');return false;}selected.forEach(function(box){var input=document.createElement('input');input.type='hidden';input.name='selectedDevice';input.value=box.value;input.dataset.fnSelection='true';form.appendChild(input);});return true;}(function(){'use strict';var version=document.getElementById('snmp-version');function fields(){var v3=version.value==='v3';document.querySelectorAll('.community-field').forEach(function(e){e.classList.toggle('hidden',v3);});document.querySelectorAll('.v3-field').forEach(function(e){e.classList.toggle('hidden',!v3);});}version.addEventListener('change',fields);fields();function bind(select,form,type){select.addEventListener('change',function(){var o=select.options[select.selectedIndex];if(!o.value){form.reset();select.value='';fields();return;}form.elements.label.value=o.dataset.label||'';if(type==='snmp'){form.elements.version.value=o.dataset.version||'v2c';form.elements.v3User.value=o.dataset.user||'';form.elements.v3SecurityLevel.value=o.dataset.level||'authPriv';form.elements.v3AuthProtocol.value=o.dataset.auth||'SHA';form.elements.v3PrivProtocol.value=o.dataset.priv||'AES';form.elements.v3Context.value=o.dataset.context||'';fields();}else{form.elements.sshUser.value=o.dataset.user||'';form.elements.sshPort.value=o.dataset.port||'22';form.elements.sshEnabled.checked=o.dataset.enabled==='true';}});}bind(document.getElementById('snmp-existing'),document.getElementById('snmp-form'),'snmp');bind(document.getElementById('ssh-existing'),document.getElementById('ssh-form'),'ssh');}());</script><script src="/assets/app-shell.js?v=20260905-240"></script></body></html>
