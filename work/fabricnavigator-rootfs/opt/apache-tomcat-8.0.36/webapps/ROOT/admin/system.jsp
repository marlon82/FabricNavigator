  }else if("configureNetwork".equals(action)){
   String mode=request.getParameter("networkMode"),networkInterface=request.getParameter("networkInterface"),address=request.getParameter("networkAddress"),prefix=request.getParameter("networkPrefix"),gateway=request.getParameter("networkGateway"),dns=request.getParameter("networkDns");if(networkInterface==null)networkInterface="";networkInterface=networkInterface.trim();if(!networkInterface.matches("[A-Za-z0-9_.: -]{0,80}"))throw new IllegalArgumentException("Invalid interface name.");if(!"dhcp".equals(mode)&&!"static".equals(mode))throw new IllegalArgumentException("Invalid network mode.");if(!validDns(dns))throw new IllegalArgumentException("Invalid IPv4 DNS configuration.");if("static".equals(mode)&&(!validIp(address)||!validPrefix(prefix)||!validIp(gateway)))throw new IllegalArgumentException("Invalid static IPv4 configuration.");Properties values=new Properties();values.setProperty("mode",mode);values.setProperty("interface",networkInterface);values.setProperty("address","static".equals(mode)?address.trim():"");values.setProperty("prefix","static".equals(mode)?prefix.trim():"");values.setProperty("gateway","static".equals(mode)?gateway.trim():"");values.setProperty("dns",dns==null?"":dns.trim());values.setProperty("requestedAt",Long.toString(System.currentTimeMillis()));values.setProperty("requestedBy",actor);Properties pendingNetwork=new Properties();pendingNetwork.putAll(values);pendingNetwork.setProperty("state","pending");pendingNetwork.setProperty("updatedAt",new Date().toString());pendingNetwork.setProperty("message","Waiting for the privileged host network service.");writeHostRequest(hostStateFile("host-network-status.properties"),pendingNetwork);writeHostRequest(hostStateFile("host-network.request"),values);AuditLog.log(actor,"HOST_NETWORK_REQUEST",mode+(address==null?"":" "+address),request.getRemoteAddr());flash="networkRequested";
