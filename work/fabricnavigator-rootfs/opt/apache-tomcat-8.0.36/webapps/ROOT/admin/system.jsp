<section class="system-panel" data-system-panel="network"><div class="system-grid"><article class="card wide"><h2 data-de="Host-Netzwerk" data-en="Host network">Host-Netzwerk</h2><p class="hint" data-de="Konfiguriert die primäre IPv4-Schnittstelle des Windows-Docker-Hosts oder der FabricNavigator-VM. Eine Adressänderung trennt die aktuelle Sitzung; öffne FabricNavigator danach über die neue Adresse." data-en="Configures the primary IPv4 interface of the Windows Docker host or FabricNavigator VM. Changing the address disconnects this session; reopen FabricNavigator through the new address."></p><dl class="certificate-status"><dt>Status</dt><dd><span class="status-pill <%=h(hostNetwork.getProperty("state",""))%>"><%=h(hostNetwork.getProperty("state","not available"))%></span></dd><dt data-de="Letzte Aktualisierung" data-en="Last update">Letzte Aktualisierung</dt><dd><%=h(hostNetwork.getProperty("updatedAt","—"))%></dd><dt data-de="Schnittstelle" data-en="Interface">Schnittstelle</dt><dd><%=h(hostNetwork.getProperty("interface","—"))%></dd><dt data-de="Modus" data-en="Mode">Modus</dt><dd><%=h(hostNetwork.getProperty("mode","—"))%></dd><dt>IPv4</dt><dd><%=h(hostNetwork.getProperty("address","—"))%><%=hostNetwork.getProperty("prefix","").length()>0?"/"+h(hostNetwork.getProperty("prefix")):""%></dd><dt>Gateway</dt><dd><%=h(hostNetwork.getProperty("gateway","—"))%></dd><dt>DNS</dt><dd><%=h(hostNetwork.getProperty("dns","—"))%></dd><dt data-de="Meldung" data-en="Message">Meldung</dt><dd><%=h(hostNetwork.getProperty("message","—"))%></dd></dl><form method="post" id="host-network-form"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="configureNetwork"><div class="wizard-fields"><label><span data-de="Modus" data-en="Mode">Modus</span><select name="networkMode" id="host-network-mode"><option value="dhcp" <%=!"static".equals(hostNetwork.getProperty("mode"))?"selected":""%>>DHCP</option><option value="static" data-de="Statische IPv4" data-en="Static IPv4" <%="static".equals(hostNetwork.getProperty("mode"))?"selected":""%>>Statische IPv4</option></select></label><label class="network-static"><span data-de="Schnittstelle (optional)" data-en="Interface (optional)">Schnittstelle (optional)</span><input name="networkInterface" maxlength="80" value="<%=h(hostNetwork.getProperty("interface",""))%>" placeholder="eth0 / Ethernet"></label><label class="network-static"><span>IPv4</span><input name="networkAddress" inputmode="decimal" value="<%=h(hostNetwork.getProperty("address",""))%>" placeholder="192.168.1.50"></label><label class="network-static"><span data-de="Präfixlänge" data-en="Prefix length">Präfixlänge</span><input name="networkPrefix" type="number" min="1" max="32" value="<%=h(hostNetwork.getProperty("prefix","24"))%>"></label><label class="network-static"><span>Gateway</span><input name="networkGateway" inputmode="decimal" value="<%=h(hostNetwork.getProperty("gateway",""))%>" placeholder="192.168.1.1"></label><label class="network-dns"><span data-de="DNS (mit Komma trennen; leer = automatisch)" data-en="DNS (comma separated; empty = automatic)">DNS (mit Komma trennen; leer = automatisch)</span><input name="networkDns" value="<%=h(hostNetwork.getProperty("dns",""))%>" placeholder="192.168.1.1, 1.1.1.1"></label></div><button type="submit" data-de="Netzwerkkonfiguration anwenden" data-en="Apply network configuration">Netzwerkkonfiguration anwenden</button></form></article></div></section>
<section class="system-panel" data-system-panel="routes"><div class="system-grid"><article class="card wide"><h2 data-de="Statische Routen" data-en="Static routes">Statische Routen</h2><p class="hint"><span data-de="Routen werden sofort auf dem Docker-Host aktiviert und nach jedem Neustart des Host-Dienstes mit der aktiven Routing-Tabelle abgeglichen." data-en="Routes are applied directly on the Docker host and reconciled with the active routing table whenever the host service starts."></span><%if(containerGateway.length()>0){%> <span data-de="Aktuelles Gateway des Docker-Hosts:" data-en="Current Docker host gateway:"></span> <strong><%=h(containerGateway)%></strong>.<%}%></p>
<form method="post" class="route-form"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="addRoute"><label><span data-de="Zielnetz" data-en="Destination network">Zielnetz</span><input name="destination" required data-de-placeholder="10.20.0.0/16 oder default" data-en-placeholder="10.20.0.0/16 or default" placeholder="10.20.0.0/16 oder default"></label><label>Gateway<input name="gateway" required inputmode="decimal" placeholder="<%=h(containerGateway.length()>0?containerGateway:"192.168.1.1")%>"></label><button type="submit" data-de="Route hinzufügen" data-en="Add route">Route hinzufügen</button></form>
<h3 data-de="Gespeicherte statische Routen" data-en="Saved static routes">Gespeicherte statische Routen</h3><table><thead><tr><th data-de="Zielnetz" data-en="Destination network">Zielnetz</th><th>Gateway</th><th>Status</th><th></th></tr></thead><tbody><%for(String[] r:routes){boolean routeActive=activeRoute(active,r[0],r[1]);%><tr><td><%=h(r[0])%></td><td><%=h(r[1])%></td><td><span class="route-state <%=routeActive?"active":""%>" data-route-active="<%=routeActive%>"></span></td><td><form method="post"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="deleteRoute"><input type="hidden" name="destination" value="<%=h(r[0])%>"><input type="hidden" name="gateway" value="<%=h(r[1])%>"><button class="danger" type="submit" data-de="Löschen" data-en="Delete">Löschen</button></form></td></tr><%}if(routes.isEmpty()){%><tr><td colspan="4" data-de="Keine statischen Routen gespeichert." data-en="No static routes saved.">Keine statischen Routen gespeichert.</td></tr><%}%></tbody></table></article>
<article class="card wide"><h2 data-de="Aktive Routen des Docker-Hosts" data-en="Active routes on the Docker host">Aktive Routen des Docker-Hosts</h2><pre data-empty="<%=active.length()==0%>"><%=h(active)%></pre></article></div></section>
<section class="system-panel" data-system-panel="restart"><div class="system-grid"><article class="card wide"><h2 data-de="System neu starten" data-en="Restart system">System neu starten</h2><p class="hint" data-de="Startet den FabricNavigator Docker-Host beziehungsweise die FabricNavigator-VM kontrolliert neu. Aktive SSH- und WebView-Sitzungen werden dabei getrennt." data-en="Performs a controlled restart of the FabricNavigator Docker host or FabricNavigator VM. Active SSH and WebView sessions will be disconnected."></p><%if(systemAction.getProperty("state","").length()>0){%><dl class="certificate-status"><dt>Status</dt><dd><span class="status-pill <%=h(systemAction.getProperty("state",""))%>"><%=h(systemAction.getProperty("state",""))%></span></dd><dt data-de="Letzte Meldung" data-en="Last message">Letzte Meldung</dt><dd><%=h(systemAction.getProperty("message",""))%></dd></dl><%}%><form method="post"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="restartSystem"><label><span data-de="Gib zur Bestätigung RESTART ein" data-en="Enter RESTART to confirm">Gib zur Bestätigung <strong>RESTART</strong> ein</span><input name="confirmation" required autocomplete="off"></label><button type="submit" data-de="System neu starten" data-en="Restart system">System neu starten</button></form></article></div></section>
<section class="system-panel" data-system-panel="factory"><div class="system-grid"><article class="card wide danger-zone"><h2 data-de="Werkseinstellungen" data-en="Factory Default">Werkseinstellungen</h2><p data-de="Entfernt Benutzer, Zugangsdaten, Gerätezuordnungen, gespeicherte Topologien, statische Routen und das benutzerdefinierte TLS-Zertifikat. Diese Aktion kann nicht rückgängig gemacht werden." data-en="Removes users, credentials, device assignments, saved topologies, static routes, and the custom TLS certificate. This action cannot be undone."></p><form method="post"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="factoryReset"><label><span data-de="Gib zur Bestätigung FACTORY RESET ein" data-en="Enter FACTORY RESET to confirm">Gib zur Bestätigung <strong>FACTORY RESET</strong> ein</span><input name="confirmation" required autocomplete="off"></label><button class="danger" type="submit" data-de="Werkseinstellungen wiederherstellen" data-en="Restore factory defaults">Werkseinstellungen wiederherstellen</button></form></article></div></section>
</div></main>
<script>(function(){var mode=document.getElementById('host-network-mode');function updateNetworkFields(){var staticMode=mode&&mode.value==='static';document.querySelectorAll('.network-static').forEach(function(field){field.hidden=!staticMode;field.querySelectorAll('input,select').forEach(function(input){input.disabled=!staticMode;input.required=staticMode;});});}if(mode){mode.addEventListener('change',updateNetworkFields);updateNetworkFields();}}());</script>
<script>(function(){'use strict';var language=(document.documentElement.lang||'de').toLowerCase().indexOf('de')===0?'de':'en',page=document.querySelector('.page'),tabs=Array.prototype.slice.call(document.querySelectorAll('[data-system-tab]')),panels=Array.prototype.slice.call(document.querySelectorAll('[data-system-panel]')),messages={routeAdded:{de:'Die statische Route wurde dem Docker-Host hinzugefügt.',en:'The static route was added to the Docker host.'},routeDeleted:{de:'Die statische Route wurde vom Docker-Host gelöscht.',en:'The static route was removed from the Docker host.'},certificateInstalled:{de:'Das TLS-Zertifikat wurde geprüft und für den Webserver aktiviert.',en:'The TLS certificate was validated and activated for the web server.'},certificateRestored:{de:'Das vorherige TLS-Zertifikat wurde wiederhergestellt.',en:'The previous TLS certificate was restored.'},restartRequested:{de:'Der Systemneustart wurde angefordert. Der Host startet in ungefähr 10 Sekunden neu.',en:'The system restart was requested. The host will restart in approximately 10 seconds.'}};function translate(){document.querySelectorAll('[data-de][data-en]').forEach(function(element){element.textContent=element.getAttribute('data-'+language);});document.querySelectorAll('[data-de-placeholder][data-en-placeholder]').forEach(function(element){element.placeholder=element.getAttribute('data-'+language+'-placeholder');});document.querySelectorAll('[data-de-label][data-en-label]').forEach(function(element){element.setAttribute('aria-label',element.getAttribute('data-'+language+'-label'));});document.querySelectorAll('[data-route-active]').forEach(function(element){var active=element.getAttribute('data-route-active')==='true';element.textContent=active?(language==='de'?'Aktiv':'Active'):(language==='de'?'Nicht aktiv':'Inactive');});var empty=document.querySelector('pre[data-empty="true"]');if(empty)empty.textContent=language==='de'?'Der privilegierte Host-Routen-Dienst hat noch keinen Status bereitgestellt.':'The privileged host route service has not provided a status yet.';var message=document.querySelector('[data-message-key]');if(message&&messages[message.dataset.messageKey])message.textContent=messages[message.dataset.messageKey][language];}function activate(key,remember){if(['certificate','network','routes','restart','factory'].indexOf(key)<0)key='certificate';tabs.forEach(function(tab){var active=tab.dataset.systemTab===key;tab.classList.toggle('active',active);tab.setAttribute('aria-selected',active?'true':'false');tab.tabIndex=active?0:-1;});panels.forEach(function(panel){panel.hidden=panel.dataset.systemPanel!==key;});if(remember)try{localStorage.setItem('fnAdminSystemTab',key);}catch(error){}try{window.parent.postMessage({type:'fn-admin-frame-resize'},location.origin);}catch(error){}}tabs.forEach(function(tab){tab.addEventListener('click',function(){activate(tab.dataset.systemTab,true);});});var initial=page.dataset.initialTab;try{if(!initial)initial=localStorage.getItem('fnAdminSystemTab')||'';}catch(error){}translate();activate(initial||'certificate',false);
var form=document.getElementById('pkcs12-form'),fileInput=document.getElementById('pkcs12-file'),passwordInput=document.getElementById('pkcs12-password'),submit=document.getElementById('pkcs12-submit');function base64(bytes){var binary='',chunk=0x8000;for(var offset=0;offset<bytes.length;offset+=chunk){var part=bytes.subarray(offset,Math.min(offset+chunk,bytes.length));binary+=String.fromCharCode.apply(null,part);}return btoa(binary);}if(form)form.addEventListener('submit',function(event){if(document.getElementById('pkcs12-data').value)return;event.preventDefault();var file=fileInput.files&&fileInput.files[0];if(!file){window.alert(language==='de'?'Wähle eine PKCS#12-Datei aus.':'Select a PKCS#12 file.');return;}if(file.size>524288){window.alert(language==='de'?'Die PKCS#12-Datei darf höchstens 512 KiB groß sein.':'The PKCS#12 file must not exceed 512 KiB.');return;}submit.disabled=true;submit.textContent=language==='de'?'Zertifikat wird übertragen …':'Uploading certificate …';var reader=new FileReader();reader.onerror=function(){submit.disabled=false;translate();window.alert(language==='de'?'Die PKCS#12-Datei konnte nicht gelesen werden.':'Select a PKCS#12 file.');};reader.onload=function(){try{document.getElementById('pkcs12-data').value=base64(new Uint8Array(reader.result));document.getElementById('pkcs12-password-data').value=base64(new TextEncoder().encode(passwordInput.value||''));document.getElementById('pkcs12-file-name').value=file.name;form.submit();}catch(error){submit.disabled=false;translate();window.alert(language==='de'?'Die PKCS#12-Datei konnte nicht vorbereitet werden.':'The PKCS#12 file could not be prepared.');}};reader.readAsArrayBuffer(file);});document.documentElement.classList.remove('fn-shell-loading');}());</script><script>(function(){var tab=document.querySelector('[data-system-tab="network"]'),panel=document.querySelector('[data-system-panel="network"]'),mode=document.getElementById('host-network-mode'),message=document.querySelector('[data-message-key="networkRequested"]');function isDe(){return(document.documentElement.lang||'de').indexOf('de')===0;}function show(){document.querySelectorAll('[data-system-panel]').forEach(function(item){item.hidden=item!==panel;});document.querySelectorAll('[data-system-tab]').forEach(function(item){var active=item===tab;item.classList.toggle('active',active);item.setAttribute('aria-selected',active?'true':'false');});try{localStorage.setItem('fnAdminSystemTab','network');}catch(e){}}function fields(){var active=mode&&mode.value==='static';document.querySelectorAll('.network-static').forEach(function(item){item.hidden=!active;item.querySelectorAll('input').forEach(function(input){input.required=active;});});}if(tab)tab.addEventListener('click',function(event){event.stopImmediatePropagation();show();},true);if(mode){mode.addEventListener('change',fields);fields();}if(message)message.textContent=isDe()?'Die neue Host-Netzwerkkonfiguration wurde angefordert.':'The new host network configuration was requested.';var initial=document.querySelector('.page').dataset.initialTab;try{if(initial==='network'||(!initial&&localStorage.getItem('fnAdminSystemTab')==='network'))show();}catch(e){if(initial==='network')show();}}());</script></body></html>
