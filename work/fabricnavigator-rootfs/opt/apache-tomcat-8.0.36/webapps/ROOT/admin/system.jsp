private static String h(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private static boolean validDestination(String value){return value!=null&&(value.equals("default")||value.matches("(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)){3}/(?:[0-9]|[12][0-9]|3[0-2])"));}
private static boolean validIp(String value){return value!=null&&value.matches("(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)(?:\\.(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)){3}");}
private static boolean validPrefix(String value){try{int prefix=Integer.parseInt(value);return prefix>=1&&prefix<=32;}catch(Exception ex){return false;}}
private static boolean validDns(String value){if(value==null||value.trim().length()==0)return true;String[] entries=value.split(",",-1);if(entries.length>3)return false;for(String entry:entries)if(!validIp(entry.trim()))return false;return true;}
private static File hostStateFile(String name){String root=System.getenv("FABRICNAVIGATOR_UPDATE_DIR");if(root==null||root.trim().length()==0)root="/opt/fabricnavigator/update";return new File(root,name);}
private static String readText(File file){if(!file.isFile())return "";try{BufferedReader br=new BufferedReader(new InputStreamReader(new FileInputStream(file),"UTF-8"));try{StringBuilder out=new StringBuilder();String line;while((line=br.readLine())!=null)out.append(line).append('\n');return out.toString();}finally{br.close();}}catch(Exception ignored){return "";}}
private static Properties readProperties(File file){Properties result=new Properties();if(!file.isFile())return result;try{InputStream in=new FileInputStream(file);try{result.load(new InputStreamReader(in,"UTF-8"));}finally{in.close();}}catch(Exception ignored){}return result;}
private static void writeHostRequest(File file,Properties values)throws Exception{File parent=file.getParentFile();parent.mkdirs();File temporary=File.createTempFile(file.getName()+".",".tmp",parent);Writer writer=new OutputStreamWriter(new FileOutputStream(temporary),"UTF-8");try{values.store(writer,"FabricNavigator privileged request");}finally{writer.close();}Files.move(temporary.toPath(),file.toPath(),StandardCopyOption.REPLACE_EXISTING,StandardCopyOption.ATOMIC_MOVE);}
private static String defaultGateway(){return readText(hostStateFile("host-route-gateway.txt")).trim();}
private static String[] routeManagerStatus(String destination,String gateway){String line=readText(hostStateFile("host-route-status.txt")).trim();String[] p=line.split("\\|",4);return p.length>=3&&p[0].equals(destination)&&p[1].equals(gateway)?p:new String[0];}
private static void waitForRoute(String destination,String gateway,String expected,long previousStatusTime)throws Exception{File statusFile=hostStateFile("host-route-status.txt");for(int i=0;i<120;i++){String[] status=routeManagerStatus(destination,gateway);if(statusFile.lastModified()>previousStatusTime&&status.length>=3){if(expected.equals(status[2]))return;if("error".equals(status[2]))throw new IOException("Host route could not be applied: "+(status.length==4?status[3]:"Unknown error"));}Thread.sleep(125);}throw new IOException("The privileged host route service did not respond within 15 seconds.");}
private static Properties waitForTlsCertificate(long previousStatusTime)throws Exception{File statusFile=hostStateFile("tls-certificate-status.properties");Properties status=new Properties();for(int i=0;i<240;i++){Thread.sleep(125);status=readProperties(statusFile);if(statusFile.lastModified()>previousStatusTime&&("active".equals(status.getProperty("state"))||"error".equals(status.getProperty("state"))))return status;}throw new IOException("The certificate service did not respond within 30 seconds.");}
private static List<String[]> readRoutes(File file)throws Exception{List<String[]> result=new ArrayList<String[]>();if(!file.isFile())return result;BufferedReader br=new BufferedReader(new InputStreamReader(new FileInputStream(file),"UTF-8"));try{String line;while((line=br.readLine())!=null){String[] p=line.trim().split("\\|",-1);if(p.length==2&&validDestination(p[0])&&validIp(p[1]))result.add(p);}}finally{br.close();}return result;}
private static void writeRoutes(File file,List<String[]> routes)throws Exception{file.getParentFile().mkdirs();Writer w=new OutputStreamWriter(new FileOutputStream(file,false),"UTF-8");try{for(String[] r:routes)w.write(r[0]+"|"+r[1]+"\n");}finally{w.close();}}
private static boolean activeRoute(String snapshot,String destination,String gateway){if(snapshot==null)return false;String wanted="default".equals(destination)?"0.0.0.0/0":destination;for(String line:snapshot.split("\\r?\\n")){String normalized=line.trim();if((normalized.contains(wanted)||(destination.equals("default")&&normalized.startsWith("default ")))&&normalized.contains(gateway))return true;}return false;}
private static void clearDirectory(File root)throws Exception{if(!root.exists())return;final Path base=root.toPath().toRealPath();Files.walkFileTree(base,new SimpleFileVisitor<Path>(){public FileVisitResult visitFile(Path file,BasicFileAttributes attrs)throws IOException{Files.delete(file);return FileVisitResult.CONTINUE;}public FileVisitResult postVisitDirectory(Path dir,IOException exc)throws IOException{if(!dir.equals(base))Files.delete(dir);return FileVisitResult.CONTINUE;}});}
