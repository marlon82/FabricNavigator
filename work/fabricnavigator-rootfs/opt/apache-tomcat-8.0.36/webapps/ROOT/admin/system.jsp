   List<String[]> originalRoutes=readRoutes(routeFile),routes=new ArrayList<String[]>(originalRoutes);for(Iterator<String[]> it=routes.iterator();it.hasNext();)if(it.next()[0].equals(destination))it.remove();routes.add(new String[]{destination,gateway});long previousStatusTime=hostStateFile("host-route-status.txt").lastModified();writeRoutes(routeFile,routes);try{waitForRoute(destination,gateway,"ok",previousStatusTime);}catch(Exception routeError){writeRoutes(routeFile,originalRoutes);throw routeError;}AuditLog.log(actor,"ADD_STATIC_ROUTE",destination+" via "+gateway,request.getRemoteAddr());flash="routeAdded";
