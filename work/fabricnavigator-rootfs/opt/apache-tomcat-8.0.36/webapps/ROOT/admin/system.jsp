   long previousStatusTime=tlsStatusFile.isFile()?tlsStatusFile.lastModified():0;Properties values=new Properties();values.setProperty("action","install");values.setProperty("pkcs12",pkcs12);values.setProperty("password",password);values.setProperty("fileName",fileName==null?"certificate.p12":fileName.replaceAll("[^A-Za-z0-9_.-]","_"));values.setProperty("requestedAt",Long.toString(System.currentTimeMillis()));writeHostRequest(hostStateFile("tls-certificate.request"),values);pkcs12=null;password=null;Properties result=waitForTlsCertificate(previousStatusTime);if(!"active".equals(result.getProperty("state")))throw new IOException(result.getProperty("message","The certificate could not be activated."));AuditLog.log(actor,"TLS_CERTIFICATE_INSTALLED",result.getProperty("fingerprint","unknown"),request.getRemoteAddr());flash="certificateInstalled";
