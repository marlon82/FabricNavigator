<%@ page import="com.fabricnavigator.security.EdmSecurity,com.fabricnavigator.security.AuditLog,java.io.*,java.nio.file.*,java.util.*" %><%@ page contentType="application/json; charset=UTF-8" pageEncoding="UTF-8" %><%!
private static final File FILE=new File(System.getenv("FABRICNAVIGATOR_UPDATE_DIR")!=null?System.getenv("FABRICNAVIGATOR_UPDATE_DIR"):"/opt/fabricnavigator/update","update-settings.properties");
private static Properties read(){Properties p=new Properties();if(!FILE.isFile())return p;try{Reader r=new InputStreamReader(new FileInputStream(FILE),"UTF-8");try{p.load(r);}finally{r.close();}}catch(Exception ignored){}return p;}
private static void write(Properties p)throws Exception{FILE.getParentFile().mkdirs();File t=File.createTempFile("update-settings.",".tmp",FILE.getParentFile());Writer w=new OutputStreamWriter(new FileOutputStream(t),"UTF-8");try{p.store(w,"FabricNavigator update settings");}finally{w.close();}Files.move(t.toPath(),FILE.toPath(),StandardCopyOption.REPLACE_EXISTING,StandardCopyOption.ATOMIC_MOVE);}
%><%response.setHeader("Cache-Control","no-store");if(!EdmSecurity.isAdmin(request)){response.sendError(403);return;}Properties p=read();if("POST".equalsIgnoreCase(request.getMethod())){if(!EdmSecurity.validCsrf(request)){response.sendError(403);return;}String channel="beta".equals(request.getParameter("channel"))?"beta":"stable";p.setProperty("channel",channel);if(!p.containsKey("automaticCheck"))p.setProperty("automaticCheck","true");p.setProperty("updatedAt",Long.toString(System.currentTimeMillis()));write(p);AuditLog.log(EdmSecurity.currentUser(request),"UPDATE_CHANNEL",channel,request.getRemoteAddr());}out.print("{\"channel\":\""+("beta".equals(p.getProperty("channel"))?"beta":"stable")+"\"}");%>
