private static String h(String value){if(value==null)return "";return value.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;");}
private static int number(String value,int fallback){try{return Integer.parseInt(value);}catch(Exception ex){return fallback;}}
private static List<String[]> diff(String before,String after){String[] a=before.replace("\r","").split("\n",-1),b=after.replace("\r","").split("\n",-1);List<String[]> out=new ArrayList<String[]>();int i=0,j=0,look=16;while(i<a.length||j<b.length){if(i<a.length&&j<b.length&&a[i].equals(b[j])){out.add(new String[]{"same",a[i]});i++;j++;continue;}int add=-1,remove=-1;if(i<a.length)for(int k=j+1;k<Math.min(b.length,j+look);k++)if(a[i].equals(b[k])){add=k;break;}if(j<b.length)for(int k=i+1;k<Math.min(a.length,i+look);k++)if(b[j].equals(a[k])){remove=k;break;}if(add>=0&&(remove<0||add-j<=remove-i)){while(j<add)out.add(new String[]{"add",b[j++]});continue;}if(remove>=0){while(i<remove)out.add(new String[]{"remove",a[i++]});continue;}if(i<a.length)out.add(new String[]{"remove",a[i++]});if(j<b.length)out.add(new String[]{"add",b[j++]});}return out;}
