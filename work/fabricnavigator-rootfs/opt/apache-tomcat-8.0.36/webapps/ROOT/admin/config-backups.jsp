.fn-backup-warning{padding:10px 12px;border:1px solid color-mix(in srgb,#f59e0b 68%,var(--fn-border));border-radius:10px;background:color-mix(in srgb,#f59e0b 13%,var(--fn-panel));color:var(--fn-text);font-size:11px}.fn-restore-dialog,.fn-backup-working{position:fixed;inset:0;z-index:15000;display:grid;place-items:center;padding:20px;background:rgba(3,9,22,.68);backdrop-filter:blur(7px)}.fn-restore-dialog[hidden],.fn-backup-working[hidden]{display:none}.fn-restore-card,.fn-backup-working-card{width:min(540px,calc(100vw - 32px));padding:22px;border:1px solid var(--fn-accent);border-top:4px solid var(--fn-accent);border-radius:17px;background:var(--fn-panel);color:var(--fn-text);box-shadow:0 30px 80px rgba(0,0,0,.45)}.fn-restore-card footer{display:flex;justify-content:flex-end;gap:9px;margin-top:16px}.fn-backup-working-card{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:16px}.fn-backup-spinner{width:34px;height:34px;border:4px solid color-mix(in srgb,var(--fn-accent) 22%,transparent);border-top-color:var(--fn-accent);border-radius:50%;animation:fn-backup-spin .85s linear infinite}@keyframes fn-backup-spin{to{transform:rotate(360deg)}}@media(max-width:760px){.fn-backup-grid{grid-template-columns:1fr}.fn-backup-card.wide{grid-column:auto}}
