<section class="fn-backup-card wide"><h2 data-de="Konfigurations-Backup und Versionsvergleich" data-en="Configuration backup and version comparison"></h2><p data-de="FabricEngine-, VSP- und VOSS-Geräte werden vollständig mit ‘backup configure’ gesichert; FabricNavigator ruft das Archiv per SCP ab. Die Textkonfiguration bleibt zusätzlich für Diff und Versionsvergleich erhalten. SwitchEngine- und EXOS-Geräte werden als Textkonfiguration gesichert. Vor jeder Wiederherstellung wird automatisch ein zusätzlicher Sicherungsstand angelegt." data-en="FabricEngine, VSP, and VOSS devices are fully backed up with ‘backup configure’; FabricNavigator retrieves the archive over SCP. The text configuration is retained for diffs and version comparison. SwitchEngine and EXOS devices are backed up as text configurations. An additional safety backup is created before every restore."></p><div class="fn-backup-form"><form method="post"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="captureAll"><button type="submit" data-de="Alle Geräte jetzt sichern" data-en="Back up all devices now"></button></form><span><b data-de="Letzter Status:" data-en="Latest status:"></b> <%=h(status.getProperty("message","Noch nicht ausgeführt"))%></span></div></section>
<div class="fn-backup-grid"><section class="fn-backup-card"><h2 data-de="Automatische Sicherung" data-en="Automatic backup"></h2><p data-de="Der Zeitplan läuft im Hintergrund. Es werden nur Geräte mit SSH-Profil und unverändertem, freigegebenem Hostschlüssel verarbeitet." data-en="The schedule runs in the background. Only devices with an SSH profile and an unchanged approved host key are processed."></p><form class="fn-backup-form" method="post"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="settings"><label><span data-de="Automatisch sichern" data-en="Automatic backup"></span><select name="enabled"><option value="false" <%="true".equals(settings.getProperty("enabled"))?"":"selected"%> data-de="Deaktiviert" data-en="Disabled"></option><option value="true" <%="true".equals(settings.getProperty("enabled"))?"selected":""%> data-de="Aktiviert" data-en="Enabled"></option></select></label><label><span data-de="Intervall (Stunden)" data-en="Interval (hours)"></span><input type="number" name="intervalHours" min="1" max="720" value="<%=h(settings.getProperty("intervalHours","24"))%>"></label><label><span data-de="Versionen je Gerät" data-en="Versions per device"></span><input type="number" name="retention" min="2" max="500" value="<%=h(settings.getProperty("retention","30"))%>"></label><button type="submit" data-de="Einstellungen speichern" data-en="Save settings"></button></form></section>
<section class="fn-backup-card"><h2 data-de="Gerät auswählen" data-en="Select device"></h2><form class="fn-backup-form" method="get"><label><span data-de="Gerät mit SSH-Zugang" data-en="Device with SSH access"></span><select name="device" onchange="this.form.submit()"><%for(String device:devices){%><option value="<%=h(device)%>" <%=device.equals(selected)?"selected":""%>><%=h(device)%></option><%}%></select></label><noscript><button type="submit">Open</button></noscript></form><%if(selected.length()>0){%><form class="fn-backup-form" method="post"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="capture"><input type="hidden" name="device" value="<%=h(selected)%>"><button type="submit" data-de="Gerät jetzt sichern" data-en="Back up device now"></button></form><%}%></section>
<section class="fn-backup-card wide"><h2 data-de="Gespeicherte Versionen" data-en="Stored versions"></h2><p data-de="„Geändert durch“ zeigt den bekannten FabricNavigator-Benutzer bei Wiederherstellungen. Bei außerhalb von FabricNavigator vorgenommenen Änderungen kann der Switch-Benutzer ohne Accounting nicht sicher ermittelt werden." data-en="Changed by identifies a known FabricNavigator user for restores. Without device accounting, changes made outside FabricNavigator cannot be attributed to a switch user reliably."></p><div class="scroll"><table class="fn-backup-table"><thead><tr><th data-de="Zeitpunkt" data-en="Captured"></th><th data-de="Plattform" data-en="Platform"></th><th data-de="Sicherungsart" data-en="Backup type"></th><th data-de="Sicherung durch" data-en="Captured by"></th><th data-de="Geändert durch" data-en="Changed by"></th><th data-de="Quelle" data-en="Source"></th><th>SHA-256</th><th data-de="Aktionen" data-en="Actions"></th></tr></thead><tbody><%for(Record version:versions){boolean full=version.archive!=null&&version.archive.toFile().isFile();%><tr><td><%=h(version.capturedAt)%></td><td><%=h(version.platform)%></td><td><span data-de="<%=full?"Vollarchiv + Diff":"Nur Text"%>" data-en="<%=full?"Full archive + diff":"Text only"%>"></span></td><td><%=h(version.capturedBy)%></td><td><%=h(version.changeActor)%></td><td><%=h(version.source)%></td><td><code><%=h(version.sha256.substring(0,Math.min(12,version.sha256.length())))%>…</code></td><td><%if(full&&"fabricengine".equals(version.platform)){%><a class="button secondary small" href="?device=<%=h(selected)%>&view=<%=h(version.id)%>" data-de="Anzeigen" data-en="View"></a> <%}%><a class="button secondary small" href="?device=<%=h(selected)%>&download=<%=h(version.id)%>" data-de="Text" data-en="Text"></a> <%if(full){%><a class="button secondary small" href="/admin/configuration-archive?device=<%=h(selected)%>&version=<%=h(version.id)%>" data-de="Download" data-en="Download"></a><%}%> <%if(!"fabricengine".equals(version.platform)||full){%><button type="button" class="danger small fn-restore-open" data-version="<%=h(version.id)%>" data-captured="<%=h(version.capturedAt)%>" data-de="Wiederherstellen" data-en="Restore"></button><%}%> <button type="button" class="danger small fn-delete-open" data-version="<%=h(version.id)%>" data-captured="<%=h(version.capturedAt)%>" data-de="Löschen" data-en="Delete"></button></td></tr><%}%><%if(versions.isEmpty()){%><tr><td colspan="8" data-de="Noch keine Konfigurationsversion vorhanden." data-en="No configuration version is available yet."></td></tr><%}%></tbody></table></div></section>
<section class="fn-backup-card wide"><h2 data-de="Versionen vergleichen" data-en="Compare versions"></h2><form class="fn-backup-form" method="get"><input type="hidden" name="device" value="<%=h(selected)%>"><label><span data-de="Ausgangsversion" data-en="Base version"></span><select name="before"><%for(Record version:versions){%><option value="<%=h(version.id)%>" <%=version.id.equals(beforeId)?"selected":""%>><%=h(version.capturedAt)%> · <%=h(version.capturedBy)%></option><%}%></select></label><label><span data-de="Vergleichsversion" data-en="Compared version"></span><select name="after"><%for(Record version:versions){%><option value="<%=h(version.id)%>" <%=version.id.equals(afterId)?"selected":""%>><%=h(version.capturedAt)%> · <%=h(version.capturedBy)%></option><%}%></select></label><button type="submit" data-de="Diff anzeigen" data-en="Show diff"></button></form><%if(changes!=null){%><div class="fn-diff"><%for(String[] row:changes){String marker="add".equals(row[0])?"+":"remove".equals(row[0])?"−":" ";%><div class="fn-diff-row fn-diff-<%=row[0]%>"><span><%=marker%></span><span><%=h(row[1])%></span></div><%}%></div><%}%></section></div></main>
<div class="fn-restore-dialog" hidden><section class="fn-restore-card" role="dialog" aria-modal="true"><h2 data-de="Ältere Konfiguration wiederherstellen?" data-en="Restore older configuration?"></h2><p data-de="Die aktuelle Konfiguration wird zuerst gesichert. Anschließend werden die gespeicherten Konfigurationsbefehle auf das Gerät angewendet und gespeichert. Die Verbindung kann dabei unterbrochen werden." data-en="The current configuration is backed up first. The stored configuration commands are then applied to the device and saved. Connectivity may be interrupted."></p><div class="fn-backup-warning" data-de="Vorsicht: Prüfe den Diff vor der Wiederherstellung. Management-IP-, AAA- oder Port-Änderungen können den Zugriff auf das Gerät unterbrechen." data-en="Caution: Review the diff before restoring. Management IP, AAA, or port changes can interrupt access to the device."></div><strong class="fn-restore-target"></strong><footer><button type="button" class="secondary fn-restore-cancel" data-de="Abbrechen" data-en="Cancel"></button><form method="post"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="restore"><input type="hidden" name="device" value="<%=h(selected)%>"><input type="hidden" name="version"><input type="hidden" name="confirmation" value="RESTORE"><button type="submit" class="danger" data-de="Sicherung erstellen und wiederherstellen" data-en="Create safety backup and restore"></button></form></footer></section></div>
<div class="fn-delete-dialog" hidden><section class="fn-delete-card" role="dialog" aria-modal="true"><h2 data-de="Sicherungsstand löschen?" data-en="Delete backup version?"></h2><p data-de="Die Textkonfiguration, das vollständige Archiv und die Metadaten dieses Sicherungsstands werden dauerhaft gelöscht." data-en="The text configuration, full archive, and metadata for this backup version will be permanently deleted."></p><strong class="fn-delete-target"></strong><footer><button type="button" class="secondary fn-delete-cancel" data-de="Abbrechen" data-en="Cancel"></button><form method="post"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="delete"><input type="hidden" name="device" value="<%=h(selected)%>"><input type="hidden" name="version"><input type="hidden" name="confirmation" value="DELETE"><button type="submit" class="danger" data-de="Sicherungsstand löschen" data-en="Delete backup version"></button></form></footer></section></div>
<div class="fn-view-dialog" <%=viewContent.length()==0?"hidden":""%>><section class="fn-view-card" role="dialog" aria-modal="true"><header><div><h2 data-de="ASCII-Konfiguration aus dem Vollarchiv" data-en="ASCII configuration from full archive"></h2><small><%=h(viewVersion)%></small></div><button type="button" class="secondary fn-view-close" aria-label="Close">×</button></header><pre class="fn-view-config"><%=h(viewContent)%></pre></section></div>
<div class="fn-backup-working" hidden><section class="fn-backup-working-card" role="status" aria-live="polite"><span class="fn-backup-spinner" aria-hidden="true"></span><div><strong data-de="Konfigurationsvorgang läuft" data-en="Configuration operation in progress"></strong><p data-de="FabricNavigator verbindet sich per SSH. Lass diese Seite geöffnet; der Vorgang kann einige Minuten dauern." data-en="FabricNavigator is connecting over SSH. Keep this page open; the operation may take several minutes."></p></div></section></div>
<script>(function(){var pre=document.querySelector('.fn-view-config');if(!pre)return;var source=pre.textContent.replace(/\r/g,''),fragment=document.createDocumentFragment();source.split('\n').forEach(function(line){var row=document.createElement('div');row.className='fn-config-line';if(/^\s*[#!]/.test(line)){row.classList.add(/CONFIGURATION|CONFIG\b/i.test(line)?'fn-config-section':'fn-config-comment');row.textContent=line;fragment.appendChild(row);return;}var expression=/("(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|\b(?:\d{1,3}\.){3}\d{1,3}\b|\b\d+\b|^\s*[A-Za-z][A-Za-z0-9_-]*)/g,last=0,match;while((match=expression.exec(line))){row.appendChild(document.createTextNode(line.slice(last,match.index)));var span=document.createElement('span'),token=match[0],trimmed=token.trim();if(match.index===0&&/^[A-Za-z]/.test(trimmed))span.className='fn-config-keyword';else if(/^\d{1,3}(?:\.\d{1,3}){3}$/.test(trimmed))span.className='fn-config-ip';else if(/^\d+$/.test(trimmed))span.className='fn-config-number';else span.className='fn-config-string';span.textContent=token;row.appendChild(span);last=expression.lastIndex;}row.appendChild(document.createTextNode(line.slice(last)));fragment.appendChild(row);});pre.textContent='';pre.appendChild(fragment);}());</script>
<script>(function(){var de=(localStorage.getItem('edmLanguage')||navigator.language||'en').toLowerCase().indexOf('de')===0;document.documentElement.lang=de?'de':'en';document.querySelectorAll('[data-de]').forEach(function(node){node.textContent=node.getAttribute(de?'data-de':'data-en');});var flash=document.querySelector('[data-flash]');if(flash){var key=flash.dataset.flash,text=key==='settings'?(de?'Backup-Einstellungen gespeichert.':'Backup settings saved.'):key==='captured'?(de?'Konfiguration wurde gesichert.':'Configuration was backed up.'):key==='restored'?(de?'Die ausgewählte Konfiguration wurde wiederhergestellt und erneut geprüft.':'The selected configuration was restored and verified again.'):key==='deleted'?(de?'Der Sicherungsstand wurde gelöscht.':'The backup version was deleted.'):(de?'Sicherung abgeschlossen: ':'Backup completed: ')+key.replace('all:','').replace(':',' / ');flash.textContent=text;}var dialog=document.querySelector('.fn-restore-dialog'),form=dialog.querySelector('form'),target=dialog.querySelector('.fn-restore-target'),working=document.querySelector('.fn-backup-working');document.querySelectorAll('.fn-restore-open').forEach(function(button){button.addEventListener('click',function(){form.elements.version.value=button.dataset.version;target.textContent=(de?'Version vom ':'Version captured ')+button.dataset.captured;dialog.hidden=false;dialog.querySelector('.fn-restore-cancel').focus();});});dialog.querySelector('.fn-restore-cancel').onclick=function(){dialog.hidden=true;};dialog.addEventListener('pointerdown',function(event){if(event.target===dialog)dialog.hidden=true;});var deleteDialog=document.querySelector('.fn-delete-dialog'),deleteForm=deleteDialog.querySelector('form'),deleteTarget=deleteDialog.querySelector('.fn-delete-target');document.querySelectorAll('.fn-delete-open').forEach(function(button){button.addEventListener('click',function(){deleteForm.elements.version.value=button.dataset.version;deleteTarget.textContent=(de?'Version vom ':'Version captured ')+button.dataset.captured;deleteDialog.hidden=false;deleteDialog.querySelector('.fn-delete-cancel').focus();});});deleteDialog.querySelector('.fn-delete-cancel').onclick=function(){deleteDialog.hidden=true;};deleteDialog.addEventListener('pointerdown',function(event){if(event.target===deleteDialog)deleteDialog.hidden=true;});var viewDialog=document.querySelector('.fn-view-dialog'),viewClose=document.querySelector('.fn-view-close');if(viewClose)viewClose.onclick=function(){viewDialog.hidden=true;};document.querySelectorAll('form[method="post"]').forEach(function(item){item.addEventListener('submit',function(){item.querySelectorAll('button').forEach(function(button){button.disabled=true;});var action=item.querySelector('input[name="action"]');if(action&&action.value!=='settings'){dialog.hidden=true;deleteDialog.hidden=true;working.hidden=false;}});});}());</script></body></html>
