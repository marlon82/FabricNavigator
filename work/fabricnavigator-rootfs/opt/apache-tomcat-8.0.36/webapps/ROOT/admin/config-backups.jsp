if(!EdmSecurity.isAdmin(request)){response.sendError(403);return;}if(!FeatureFlags.configurationBackupEnabled()){response.sendError(404);return;}response.setHeader("Cache-Control","no-store");String csrf=EdmSecurity.csrf(session),actor=EdmSecurity.currentUser(request),flash="",error="",viewContent="",viewVersion="";
String selected=request.getParameter("device");if(selected==null)selected="";
if("GET".equalsIgnoreCase(request.getMethod())&&request.getParameter("download")!=null){try{String id=request.getParameter("download");Record record=ConfigurationBackupScheduler.find(selected,id);response.setContentType("text/plain; charset=UTF-8");response.setHeader("Content-Disposition","attachment; filename=\"FabricNavigator-"+selected+"-"+id+".cfg\"");out.print(ConfigurationBackupScheduler.configuration(selected,id));return;}catch(Exception ex){response.sendError(404);return;}}
if("POST".equalsIgnoreCase(request.getMethod())){try{if(!EdmSecurity.validCsrf(request))throw new SecurityException("Session expired");String action=request.getParameter("action");if("settings".equals(action)){ConfigurationBackupScheduler.saveSettings("true".equals(request.getParameter("enabled")),number(request.getParameter("intervalHours"),24),number(request.getParameter("retention"),30),actor,request.getRemoteAddr());flash="settings";}else if("captureAll".equals(action)){int[] result=ConfigurationBackupScheduler.captureAll(actor,"manual",request.getRemoteAddr());flash="all:"+result[0]+":"+result[1];}else if("capture".equals(action)){selected=request.getParameter("device");ConfigurationBackupScheduler.capture(selected,actor,"manual",request.getRemoteAddr());flash="captured";}else if("restore".equals(action)){selected=request.getParameter("device");if(!"RESTORE".equals(request.getParameter("confirmation")))throw new IllegalArgumentException("Restore confirmation missing");ConfigurationBackupScheduler.restore(selected,request.getParameter("version"),actor,request.getRemoteAddr());flash="restored";}else if("delete".equals(action)){selected=request.getParameter("device");if(!"DELETE".equals(request.getParameter("confirmation")))throw new IllegalArgumentException("Delete confirmation missing");ConfigurationBackupScheduler.delete(selected,request.getParameter("version"),actor,request.getRemoteAddr());flash="deleted";}else throw new IllegalArgumentException("Unknown action");}catch(Exception ex){error=ex.getMessage()==null?ex.getClass().getSimpleName():ex.getMessage();}}
Set<String> allDevices=CredentialVault.listAssignedDevices();List<String> devices=new ArrayList<String>();for(String device:allDevices)try{String id=CredentialVault.getDeviceCredentialId(device,CredentialVault.TYPE_SSH);if(id!=null&&id.length()>0)devices.add(device);}catch(Exception ignored){}Collections.sort(devices);if(selected.length()==0&&!devices.isEmpty())selected=devices.get(0);List<Record> versions=new ArrayList<Record>();if(selected.length()>0)try{versions=ConfigurationBackupScheduler.list(selected);}catch(Exception ex){error=ex.getMessage();}if(request.getParameter("view")!=null)try{viewVersion=request.getParameter("view");viewContent=ConfigurationBackupScheduler.archiveConfiguration(selected,viewVersion);}catch(Exception ex){error=ex.getMessage();}Properties settings=ConfigurationBackupScheduler.settings(),status=ConfigurationBackupScheduler.status();String beforeId=request.getParameter("before"),afterId=request.getParameter("after");if(beforeId==null&&versions.size()>1)beforeId=versions.get(1).id;if(afterId==null&&!versions.isEmpty())afterId=versions.get(0).id;List<String[]> changes=null;if(beforeId!=null&&afterId!=null&&!beforeId.equals(afterId))try{changes=diff(ConfigurationBackupScheduler.configuration(selected,beforeId),ConfigurationBackupScheduler.configuration(selected,afterId));}catch(Exception ex){error=ex.getMessage();}
