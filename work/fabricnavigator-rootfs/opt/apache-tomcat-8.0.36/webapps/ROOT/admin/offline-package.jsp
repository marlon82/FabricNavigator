private static final File STATE_DIR=new File(System.getenv("FABRICNAVIGATOR_UPDATE_DIR")!=null?System.getenv("FABRICNAVIGATOR_UPDATE_DIR"):"/opt/fabricnavigator/update");
private static final File OFFLINE_DIR=new File(STATE_DIR,"offline");
private static final Pattern VERSION=Pattern.compile("\\d+\\.\\d+\\.\\d+\\.\\d+");
private static final Pattern PLUGIN_VERSION=Pattern.compile("[A-Za-z0-9][A-Za-z0-9._-]{0,31}");
private static String j(String s){if(s==null)return"";return s.replace("\\","\\\\").replace("\"","\\\"").replace("\r","").replace("\n","\\n").replace("</","<\\/");}
private static String clean(String s){return s==null?"":s.replace("\r"," ").replace("\n"," ").replace("=","-").trim();}
private static void atomicProperties(File file,Properties values)throws Exception{file.getParentFile().mkdirs();File temporary=File.createTempFile(file.getName()+".",".tmp",file.getParentFile());Writer writer=new OutputStreamWriter(new FileOutputStream(temporary),"UTF-8");try{values.store(writer,"FabricNavigator offline package");}finally{writer.close();}try{Files.move(temporary.toPath(),file.toPath(),StandardCopyOption.REPLACE_EXISTING,StandardCopyOption.ATOMIC_MOVE);}catch(AtomicMoveNotSupportedException ex){Files.move(temporary.toPath(),file.toPath(),StandardCopyOption.REPLACE_EXISTING);}}
private static Properties properties(File file){Properties p=new Properties();if(!file.isFile())return p;try{InputStream in=new FileInputStream(file);try{p.load(new InputStreamReader(in,"UTF-8"));}finally{in.close();}}catch(Exception ignored){}return p;}
private static String hex(byte[] bytes){StringBuilder b=new StringBuilder();for(byte value:bytes)b.append(String.format("%02x",value&255));return b.toString();}
private static boolean safeEntry(String name){if(name==null)return false;String n=name.replace('\\','/');if(n.startsWith("/")||n.matches("^[A-Za-z]:.*"))return false;for(String part:n.split("/",-1))if("..".equals(part))return false;return true;}
private static byte[] readEntry(ZipFile zip,ZipEntry entry,int maximum)throws Exception{InputStream in=zip.getInputStream(entry);ByteArrayOutputStream out=new ByteArrayOutputStream();try{byte[] buffer=new byte[8192];int total=0,count;while((count=in.read(buffer))!=-1){total+=count;if(total>maximum)throw new IOException("Package metadata is too large.");out.write(buffer,0,count);}return out.toByteArray();}finally{in.close();}}
private static int[] versionParts(String value){String[] p=value.split("\\.");return new int[]{Integer.parseInt(p[0]),Integer.parseInt(p[1]),Integer.parseInt(p[2]),Integer.parseInt(p[3])};}
private static int compareVersion(String left,String right){int[] a=versionParts(left),b=versionParts(right);for(int i=0;i<4;i++){if(a[i]!=b[i])return a[i]<b[i]?-1:1;}return 0;}
private static String jsonField(String json,String name){Matcher m=Pattern.compile("\\\""+Pattern.quote(name)+"\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"").matcher(json);return m.find()?m.group(1):"";}
private static long copyUpload(InputStream input,File target,long maximum,MessageDigest digest)throws Exception{OutputStream output=new FileOutputStream(target);long total=0;try{byte[] buffer=new byte[65536];int count;while((count=input.read(buffer))!=-1){total+=count;if(total>maximum)throw new IOException("The uploaded package exceeds the allowed size.");digest.update(buffer,0,count);output.write(buffer,0,count);}if(total<100)throw new IOException("The uploaded package is empty or incomplete.");return total;}finally{output.close();}}
private static void validateArchive(ZipFile zip)throws Exception{long total=0;int count=0;Enumeration<? extends ZipEntry> entries=zip.entries();while(entries.hasMoreElements()){ZipEntry entry=entries.nextElement();if(++count>4096)throw new IOException("The package contains too many files.");if(!safeEntry(entry.getName()))throw new IOException("Unsafe path in package: "+entry.getName());long size=entry.getSize();if(size>268435456L)throw new IOException("A package file exceeds the allowed size.");if(size>0){total+=size;if(total>1073741824L)throw new IOException("The unpacked package is too large.");}}}
