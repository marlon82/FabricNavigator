<%@ page import="java.io.*,java.nio.file.*,java.util.*,com.fabricnavigator.security.EdmSecurity,com.fabricnavigator.security.CredentialVault,com.fabricnavigator.security.AuditLog" %><%@ page contentType="application/json; charset=UTF-8" pageEncoding="UTF-8" %><%!
private static final Path SETTINGS=Paths.get("/opt/fabricnavigator/data/default-credential-assignments.properties"),WEB_IDS=Paths.get("/opt/fabricnavigator/data/webview-profile-ids.properties");
private static Properties load(Path path)throws IOException{Properties p=new Properties();if(Files.isRegularFile(path))try(InputStream in=Files.newInputStream(path)){p.load(in);}return p;}
private static synchronized void save(Properties p)throws IOException{Files.createDirectories(SETTINGS.getParent());Path tmp=Files.createTempFile(SETTINGS.getParent(),"credential-defaults.",".tmp");try{try(OutputStream out=Files.newOutputStream(tmp)){p.store(out,"FabricNavigator default credential assignments (no secrets)");}try{Files.move(tmp,SETTINGS,StandardCopyOption.ATOMIC_MOVE,StandardCopyOption.REPLACE_EXISTING);}catch(AtomicMoveNotSupportedException ex){Files.move(tmp,SETTINGS,StandardCopyOption.REPLACE_EXISTING);}}finally{Files.deleteIfExists(tmp);}}
private static String json(String value){return value==null?"":value.replace("\\","\\\\").replace("\"","\\\"");}
%><%if(!EdmSecurity.isAdmin(request)){response.sendError(403);return;}response.setHeader("Cache-Control","no-store");Properties settings=load(SETTINGS);if("POST".equalsIgnoreCase(request.getMethod())){if(!EdmSecurity.validCsrf(request)){response.sendError(403);return;}String kind=request.getParameter("kind"),id=request.getParameter("credentialId");if(!"ssh".equals(kind)&&!"web".equals(kind)){response.sendError(400);return;}if(id==null)id="";if(id.length()>0){Properties credential=CredentialVault.getCredential(id),webIds=load(WEB_IDS);if(!CredentialVault.TYPE_SSH.equals(credential.getProperty("type"))||("web".equals(kind)!=webIds.containsKey(id))){response.sendError(400);return;}settings.setProperty(kind+"CredentialId",id);}else settings.remove(kind+"CredentialId");save(settings);AuditLog.log(EdmSecurity.currentUser(request),"SET_DEFAULT_"+kind.toUpperCase(Locale.ENGLISH)+"_CREDENTIAL",id,request.getRemoteAddr());}out.print("{\"csrf\":\""+json(EdmSecurity.csrf(session))+"\",\"sshCredentialId\":\""+json(settings.getProperty("sshCredentialId",""))+"\",\"webCredentialId\":\""+json(settings.getProperty("webCredentialId",""))+"\"}");%>
