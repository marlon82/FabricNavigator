<%@ page import="java.io.*,java.nio.file.*,java.util.*,com.fabricnavigator.security.EdmSecurity,com.fabricnavigator.security.CredentialVault,com.fabricnavigator.security.AuditLog" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%!
private static final Path ASSIGNMENTS=Paths.get("/opt/fabricnavigator/data/webview-assignments.properties");
private static final Path PROFILE_IDS=Paths.get("/opt/fabricnavigator/data/webview-profile-ids.properties");
private static final Path DEFAULT_ASSIGNMENTS=Paths.get("/opt/fabricnavigator/data/default-credential-assignments.properties");
private static String h(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private static String json(String s){if(s==null)return "";return s.replace("\\","\\\\").replace("\"","\\\"").replace("\r","\\r").replace("\n","\\n");}
private static synchronized Properties assignments() throws IOException{Properties p=new Properties();if(Files.isRegularFile(ASSIGNMENTS))try(InputStream in=Files.newInputStream(ASSIGNMENTS)){p.load(in);}return p;}
private static synchronized void saveAssignments(Properties p) throws IOException{Files.createDirectories(ASSIGNMENTS.getParent());Path tmp=Files.createTempFile(ASSIGNMENTS.getParent(),"webview-assign.",".tmp");try{try(OutputStream out=Files.newOutputStream(tmp)){p.store(out,"FabricNavigator WebView profile assignments (no secrets)");}try{Files.move(tmp,ASSIGNMENTS,StandardCopyOption.ATOMIC_MOVE,StandardCopyOption.REPLACE_EXISTING);}catch(AtomicMoveNotSupportedException ex){Files.move(tmp,ASSIGNMENTS,StandardCopyOption.REPLACE_EXISTING);}}finally{Files.deleteIfExists(tmp);}}
private static synchronized Properties profileIds() throws IOException{Properties p=new Properties();if(Files.isRegularFile(PROFILE_IDS))try(InputStream in=Files.newInputStream(PROFILE_IDS)){p.load(in);}return p;}
private static synchronized void saveProfileIds(Properties p) throws IOException{Files.createDirectories(PROFILE_IDS.getParent());Path tmp=Files.createTempFile(PROFILE_IDS.getParent(),"webview-profiles.",".tmp");try{try(OutputStream out=Files.newOutputStream(tmp)){p.store(out,"FabricNavigator WebView credential IDs (no secrets)");}try{Files.move(tmp,PROFILE_IDS,StandardCopyOption.ATOMIC_MOVE,StandardCopyOption.REPLACE_EXISTING);}catch(AtomicMoveNotSupportedException ex){Files.move(tmp,PROFILE_IDS,StandardCopyOption.REPLACE_EXISTING);}}finally{Files.deleteIfExists(tmp);}}
private static synchronized Properties defaults() throws IOException{Properties p=new Properties();if(Files.isRegularFile(DEFAULT_ASSIGNMENTS))try(InputStream in=Files.newInputStream(DEFAULT_ASSIGNMENTS)){p.load(in);}return p;}
private static synchronized void saveDefaults(Properties p) throws IOException{Files.createDirectories(DEFAULT_ASSIGNMENTS.getParent());Path tmp=Files.createTempFile(DEFAULT_ASSIGNMENTS.getParent(),"credential-defaults.",".tmp");try{try(OutputStream out=Files.newOutputStream(tmp)){p.store(out,"FabricNavigator default credential assignments (no secrets)");}try{Files.move(tmp,DEFAULT_ASSIGNMENTS,StandardCopyOption.ATOMIC_MOVE,StandardCopyOption.REPLACE_EXISTING);}catch(AtomicMoveNotSupportedException ex){Files.move(tmp,DEFAULT_ASSIGNMENTS,StandardCopyOption.REPLACE_EXISTING);}}finally{Files.deleteIfExists(tmp);}}
%>
<%
if(!EdmSecurity.isAdmin(request)){response.sendError(403);return;}
response.setHeader("Cache-Control","no-store");String csrf=EdmSecurity.csrf(session),actor=EdmSecurity.currentUser(request),flash="",error="";
if("POST".equalsIgnoreCase(request.getMethod())){
 if(!EdmSecurity.validCsrf(request)){response.sendError(403);return;}
 String action=request.getParameter("action"),target="";
 try{
  if("save".equals(action)){String id=request.getParameter("credentialId");Properties ids=profileIds();if(id==null||id.length()==0){target=CredentialVault.saveSsh("",request.getParameter("label"),request.getParameter("webUser"),443,request.getParameter("webPassword"),"","",false);ids.setProperty(target,"true");saveProfileIds(ids);}else{if(!ids.containsKey(id))throw new IllegalArgumentException("invalidProfile");target=CredentialVault.saveSsh(id,request.getParameter("label"),request.getParameter("webUser"),443,request.getParameter("webPassword"),"","",false);}flash="WebView-Profil gespeichert.";}
	  else if("assign".equals(action)){target=request.getParameter("deviceIp");Properties p=assignments(),ids=profileIds();String id=request.getParameter("webCredentialId");if(id==null||id.length()==0)p.remove(target);else if(ids.containsKey(id))p.setProperty(target,id);else throw new IllegalArgumentException("invalidProfile");saveAssignments(p);flash="Gerätezuordnung gespeichert.";}
	  else if("setDefault".equals(action)){target=request.getParameter("credentialId");Properties ids=profileIds(),p=defaults();if(target==null||target.length()==0)p.remove("webCredentialId");else{if(!ids.containsKey(target))throw new IllegalArgumentException("invalidProfile");p.setProperty("webCredentialId",target);}saveDefaults(p);flash=target==null||target.length()==0?"WebView-Standardprofil entfernt.":"WebView-Standardprofil gespeichert.";}
	  else if("delete".equals(action)){target=request.getParameter("credentialId");Properties ids=profileIds();if(target==null||!ids.containsKey(target))throw new IllegalArgumentException("invalidProfile");Properties p=assignments();for(String key:new ArrayList<String>(p.stringPropertyNames()))if(target.equals(p.getProperty(key)))p.remove(key);saveAssignments(p);Properties d=defaults();if(target.equals(d.getProperty("webCredentialId"))){d.remove("webCredentialId");saveDefaults(d);}CredentialVault.deleteCredential(target);ids.remove(target);saveProfileIds(ids);flash="WebView-Profil gelöscht.";}
  else throw new IllegalArgumentException("invalidAction");
  AuditLog.log(actor,"webview_"+action,target,request.getRemoteAddr());
 }catch(Exception ex){error="Die Änderung konnte nicht gespeichert werden. Prüfe die Eingaben und Zuordnungen.";try{AuditLog.log(actor,"FAILED_webview_"+action,target,request.getRemoteAddr());}catch(Exception ignored){}}
}
Properties registeredProfiles=profileIds(),credentialDefaults=defaults();String defaultWebId=credentialDefaults.getProperty("webCredentialId","");List<CredentialVault.Metadata> profiles=new ArrayList<CredentialVault.Metadata>();for(CredentialVault.Metadata m:CredentialVault.listCredentials(CredentialVault.TYPE_SSH))if(registeredProfiles.containsKey(m.id))profiles.add(m);Set<String> devices=CredentialVault.listAssignedDevices();Properties assigned=assignments();
if("json".equals(request.getParameter("format"))){response.setContentType("application/json; charset=UTF-8");StringBuilder data=new StringBuilder("{\"profiles\":[");for(int i=0;i<profiles.size();i++){CredentialVault.Metadata m=profiles.get(i);if(i>0)data.append(',');data.append("{\"id\":\"").append(json(m.id)).append("\",\"label\":\"").append(json(m.label)).append("\"}");}data.append("],\"defaultCredentialId\":\"").append(json(defaultWebId)).append("\",\"assignments\":{");int n=0;for(String ip:assigned.stringPropertyNames()){if(n++>0)data.append(',');data.append("\"").append(json(ip)).append("\":\"").append(json(assigned.getProperty(ip,""))).append("\"");}data.append("}}");out.print(data.toString());return;}
%>
<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WebView-Profile</title><link rel="stylesheet" href="/assets/security.css?v=20260825-146"><style>html,body{background:transparent}body{margin:0;padding:2px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.card{background:#fff;border-radius:18px;padding:24px;border:1px solid #b66cff;box-shadow:0 16px 35px -30px #31105f}.wide{grid-column:1/-1}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.full{grid-column:1/-1}label{display:grid;gap:6px;font-weight:700}input,select{width:100%;box-sizing:border-box;border:1px solid #c9ceda;border-radius:10px;padding:11px;font:inherit}.actions{display:flex;gap:8px;align-items:end}.hint{color:#667085;font-size:13px;line-height:1.5}.secret-note{background:#f5f0ff;border-left:4px solid #8d25e8;padding:12px}table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:left;padding:10px;border-bottom:1px solid #e6e8ef}.scroll{overflow:auto}.danger{background:#a4262c}.alert{padding:12px;border-radius:10px;margin-bottom:14px}.success{background:#e8f8ee;color:#176b36}.error{background:#fdecec;color:#8d1f25}@media(max-width:800px){.grid,.form-grid{grid-template-columns:1fr}.wide,.full{grid-column:auto}}</style></head><body><%if(flash.length()>0){%><div class="alert success"><%=h(flash)%></div><%}if(error.length()>0){%><div class="alert error"><%=h(error)%></div><%}%><div class="grid"><section class="card"><h2>WebView-Anmeldeprofile</h2><p class="secret-note">Passwörter werden AES-GCM-verschlüsselt gespeichert und ausschließlich serverseitig an die Geräte-Weboberfläche gesendet.</p><form class="form-grid" method="post" autocomplete="off" id="web-form"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="save"><label class="full">Profil aktualisieren (optional)<select name="credentialId" id="web-existing"><option value="">Neues Profil</option><%for(CredentialVault.Metadata m:profiles){%><option value="<%=h(m.id)%>" data-label="<%=h(m.label)%>" data-user="<%=h(m.username)%>"><%=h(m.label)%></option><%}%></select></label><label>Bezeichnung<input name="label" required maxlength="80"></label><label>Benutzername<input name="webUser" required maxlength="64" autocomplete="off"></label><label class="full">Passwort<input name="webPassword" type="password" autocomplete="new-password"><span class="hint">Bei einer Aktualisierung leer lassen, um das vorhandene Passwort beizubehalten.</span></label><div class="actions full"><button type="submit">Profil speichern</button></div></form><h3>Vorhandene Profile</h3><div class="scroll"><table><thead><tr><th>Profil</th><th>Benutzer</th><th></th></tr></thead><tbody><%for(CredentialVault.Metadata m:profiles){%><tr><td><%=h(m.label)%></td><td><%=h(m.username)%></td><td><form method="post" onsubmit="return confirm('Profil und seine Zuordnungen wirklich löschen?')"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="delete"><input type="hidden" name="credentialId" value="<%=h(m.id)%>"><button class="danger" type="submit">Löschen</button></form></td></tr><%}%></tbody></table></div></section><section class="card"><h2>Profil an Geräte binden</h2><p class="hint">Das Profil wird beim Öffnen des getunnelten WebViews verwendet. Ohne Zuordnung bleibt die normale Geräte-Anmeldeseite sichtbar.</p><div class="scroll"><table><thead><tr><th>Gerät</th><th>WebView-Profil</th><th></th></tr></thead><tbody><%for(String ip:devices){String current=assigned.getProperty(ip,"");%><tr><form method="post"><td><strong><%=h(ip)%></strong><input type="hidden" name="deviceIp" value="<%=h(ip)%>"><input type="hidden" name="csrfToken" value="<%=h(csrf)%>"><input type="hidden" name="action" value="assign"></td><td><select name="webCredentialId"><option value="">Keine automatische Anmeldung</option><%for(CredentialVault.Metadata m:profiles){%><option value="<%=h(m.id)%>" <%=m.id.equals(current)?"selected":""%>><%=h(m.label)%></option><%}%></select></td><td><button type="submit">Zuweisen</button></td></form></tr><%}%></tbody></table></div></section></div><script>(function(){var select=document.getElementById('web-existing'),form=document.getElementById('web-form');select.addEventListener('change',function(){var o=select.options[select.selectedIndex];if(!o.value){form.reset();select.value='';return;}form.elements.label.value=o.dataset.label||'';form.elements.webUser.value=o.dataset.user||'';form.elements.webPassword.value='';});}());</script></body></html>
