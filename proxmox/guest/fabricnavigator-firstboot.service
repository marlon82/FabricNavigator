[Unit]
Description=Provision FabricNavigator on first boot
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/fabricnavigator-firstboot.complete

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fabricnavigator-firstboot
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

